# Database — PostgreSQL. Use any hosted Postgres (Vercel Postgres, Neon,
# Supabase, Railway, …). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# For local development you can run Postgres locally, e.g.:
#   postgresql://postgres:postgres@127.0.0.1:5432/nikimart?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nikimart?schema=public"

# The site's own address, with scheme and no trailing slash — e.g.
# "https://your-domain". OPTIONAL but strongly recommended once you have a
# custom domain: it is what link previews, the logo inside emails, and the
# address Paystack returns a payer to after checkout are all built from.
#
# Unset, the app falls back to the platform's production domain
# (VERCEL_PROJECT_PRODUCTION_URL), so pointing a custom domain at the project
# is usually enough on its own. Set this explicitly anywhere that isn't true.
NEXT_PUBLIC_SITE_URL=""

# Auth.js secret — REQUIRED in every environment (including Vercel).
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Needed when running behind a proxy / non-localhost host.
AUTH_TRUST_HOST=true

# Paystack — payment gateway (Mobile Money + cards, Ghana). OPTIONAL.
# When unset, checkout falls back to a simulated "mark as paid" flow so local
# dev still works end to end. Set the secret key to collect real payments.
# Find your keys at https://dashboard.paystack.com/#/settings/developers
# The SECRET key is server-only — never expose it to the browser.
# Use the test key (sk_test_…) until you're ready to go live (sk_live_…).
# This one is the DATA BUNDLES account: the bundle storefront, agent
# storefronts and AFA registrations settle into it.
PAYSTACK_SECRET_KEY=""
# The RETAIL account: the mall's checkout. The two businesses settle into
# different Paystack accounts so their money arrives in separate payouts rather
# than one nobody can split afterwards. Leave it unset and retail falls back to
# PAYSTACK_SECRET_KEY, which is how it worked before the accounts were split.
RETAIL_PAYSTACK_SECRET_KEY=""
# In BOTH Paystack dashboards, set the webhook URL to:
#   https://your-domain/api/paystack/webhook
# One endpoint serves both. It works out which account signed each event and
# refuses one account's signature over the other's orders.

# Arkesel SMS — order confirmations, delivery updates, and 6-digit password-reset
# OTP codes by SMS (Ghana). OPTIONAL: when unset, SMS silently no-ops.
# Get your key at https://sms.arkesel.com (Settings → API keys).
# ARKESEL_SENDER_ID must be an APPROVED sender (max 11 chars) and your account
# must have SMS units — otherwise Arkesel rejects the send and no code arrives.
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID="Nickimart"

# Email notifications — OPTIONAL. Uses Resend (https://resend.com). When unset,
# email silently no-ops and SMS carries notifications on its own.
#
# To switch email on, BOTH of these matter — a key on its own is not enough:
#
#   1. RESEND_API_KEY — create one at https://resend.com/api-keys.
#   2. RESEND_FROM    — an address at a domain you have verified at
#                       https://resend.com/domains (add the DNS records it
#                       gives you and wait for it to go green).
#
# Leaving RESEND_FROM on the default below is the trap worth knowing about.
# `onboarding@resend.dev` is Resend's shared sandbox sender, and it only
# delivers to the address your own Resend account is registered with. Every
# customer send is refused with a 403. Nothing crashes and no order fails — the
# receipt just never arrives, while your own test email lands perfectly and
# makes it look like email is working.
#
# Admin → Settings shows which of these two states you are in and will send a
# test email that reports Resend's own answer.
RESEND_API_KEY=""
RESEND_FROM="Nickimart <onboarding@resend.dev>"
# Where replies go. Optional: without it, replies to a notification bounce off
# the from-address, which nobody reads.
RESEND_REPLY_TO=""

# Justice Datashop — the agent API that fulfils internet data bundles and AFA
# registrations sold at /data-bundles. OPTIONAL: without a key the storefront
# still takes orders, but they sit as "paid, awaiting dispatch" in
# Admin → Data → Bundle orders until you add the key and hit "Send now".
# Generate the key in your agent dashboard: justicedatashop.com → Developer →
# Authentication → Generate API Key. It spends your agent wallet — server-only,
# never expose it to the browser.
JUSTICE_API_KEY=""
# Override only if the provider moves its API. Defaults to the URL below.
JUSTICE_API_BASE="https://backend.justicedatashop.com"

# Cost prices are read from the provider's own package list, daily and on
# demand from Admin → Data → Bundle prices. The API key above is tried first;
# these are the fallback for an account whose prices sit behind the agent
# dashboard's session instead. OPTIONAL, and read-only — nothing here ever
# orders or transfers. A dashboard set to send a one-time code on sign-in
# cannot be automated, so leave these blank in that case.
JUSTICE_AGENT_PHONE=""
JUSTICE_AGENT_PASSWORD=""

# The provider's order-status callback needs no configuration: each order
# registers a callback URL whose token is derived from AUTH_SECRET.

# --- Data bundles: their own database --------------------------------------
# The bundle business (price ladder, orders, agents, ledger, referrals and the
# settings its console reads) runs on its own Postgres database. Leave this
# unset and it falls back to DATABASE_URL, which is the arrangement before the
# split — everything keeps working, it is just all in one database.
#
# To split: create the database, set this, deploy (the schema is applied
# automatically from db/data-migrations), then copy the existing rows across
# with `npm run db:copy-data`. The old tables are left in place; drop them by
# hand once you have checked the console.
DATA_DATABASE_URL=

# --- Data bundles: backups --------------------------------------------------
# Admin → Data → Store settings → Backups takes a full snapshot of the bundle
# database. The snapshot never goes back into that database — a backup kept
# inside the thing it protects is not a backup — so it needs somewhere to live.
#
# Set either of the two below, or both (both means two copies of every backup).
# With neither set, backups still work but land in the server's temp directory,
# which a restart or a deploy wipes; the console says so, loudly. That is fine
# for taking a copy you download straight away and is not disaster recovery.
#
# A directory on the server. Right for a host with a real disk or a mounted
# volume; pointless on a serverless host, where the filesystem does not persist.
DATA_BACKUP_LOCAL_DIR=

# Any S3-compatible bucket: Cloudflare R2, Amazon S3, Backblaze B2, MinIO, or
# Google Cloud Storage through its XML API (endpoint https://storage.googleapis.com
# with an HMAC key). This is the copy that survives losing the server, so it is
# the one worth setting up.
#
#   R2:     ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  REGION=auto
#   S3:     leave ENDPOINT empty and set REGION to the bucket's region
#   GCS:    ENDPOINT=https://storage.googleapis.com  REGION=auto
#
# The bucket should not be public, and should have its own retention/versioning.
DATA_BACKUP_S3_BUCKET=""
DATA_BACKUP_S3_REGION="auto"
DATA_BACKUP_S3_ENDPOINT=""
DATA_BACKUP_S3_ACCESS_KEY_ID=""
DATA_BACKUP_S3_SECRET_ACCESS_KEY=""
# Key prefix inside the bucket. Defaults to nickimart/data-bundles/.
DATA_BACKUP_S3_PREFIX=""
# What the console calls this destination, e.g. "Cloudflare R2".
DATA_BACKUP_S3_LABEL=""

# Ceiling on one uncompressed snapshot, in bytes. Default 512 MB. A dump that
# exceeds it fails cleanly instead of exhausting the process.
DATA_BACKUP_MAX_BYTES=

# Ceiling on a backup file uploaded on the Restore screen, in bytes. Default
# 256 MB, and checked twice: once against the declared length before reading,
# and once against what actually arrived.
DATA_BACKUP_MAX_UPLOAD_BYTES=

# A note on restore, which has no setting of its own: it runs in one
# transaction and can take minutes on a large database, so the host's function
# timeout has to be longer than the restore. On Vercel that is maxDuration;
# the default on the Hobby plan is far too short for anything but a small
# database. A restore that is cut off mid-transaction rolls back and changes
# nothing, so the risk is a wasted attempt rather than a damaged database.

# --- Scheduled jobs ---------------------------------------------------------
# The bearer token Vercel sends on its cron requests. The existing jobs treat
# it as optional, because all they do is re-drive work that was already paid
# for. /api/cron/data-backup does NOT: it writes a copy of the whole bundle
# business to storage on demand, so with no secret set it refuses to run at all
# and the Backups tab says why. Generate any long random string.
CRON_SECRET=""

# --- Live chat --------------------------------------------------------------
# Team sessions are carried by Ably rather than by this app: browsers connect
# to it directly, so no serverless function is held open for the length of a
# conversation and no database row is written per message. The key is signed
# server-side into a short-lived token scoped to one room, and never reaches
# the browser.
#
# Leave it unset and sessions can still be scheduled — the rooms just cannot be
# opened, and the screen says so.
ABLY_API_KEY=""
