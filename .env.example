# Database — PostgreSQL. Use any hosted Postgres (Vercel Postgres, Neon,
# Supabase, Railway, …). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# For local development you can run Postgres locally, e.g.:
#   postgresql://postgres:postgres@127.0.0.1:5432/nikimart?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nikimart?schema=public"

# Auth.js secret — REQUIRED in every environment (including Vercel).
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Needed when running behind a proxy / non-localhost host.
AUTH_TRUST_HOST=true

# Paystack — payment gateway (Mobile Money + cards, Ghana). OPTIONAL.
# When unset, checkout falls back to a simulated "mark as paid" flow so local
# dev still works end to end. Set the secret key to collect real payments.
# Find your keys at https://dashboard.paystack.com/#/settings/developers
# The SECRET key is server-only — never expose it to the browser.
# Use the test key (sk_test_…) until you're ready to go live (sk_live_…).
PAYSTACK_SECRET_KEY=""
# In the Paystack dashboard, set the webhook URL to:
#   https://your-domain/api/paystack/webhook

# Arkesel SMS — order confirmations, delivery updates, and 6-digit password-reset
# OTP codes by SMS (Ghana). OPTIONAL: when unset, SMS silently no-ops.
# Get your key at https://sms.arkesel.com (Settings → API keys).
# ARKESEL_SENDER_ID must be an APPROVED sender (max 11 chars) and your account
# must have SMS units — otherwise Arkesel rejects the send and no code arrives.
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID="NikiMart"

# Email notifications — OPTIONAL. Uses Resend (https://resend.com). When unset,
# email silently no-ops and SMS carries notifications. RESEND_FROM must be a
# verified sender/domain.
RESEND_API_KEY=""
RESEND_FROM="NikiMart <onboarding@resend.dev>"

# Justice Datashop — the agent API that fulfils internet data bundles and AFA
# registrations sold at /data-bundles. OPTIONAL: without a key the storefront
# still takes orders, but they sit as "paid, awaiting dispatch" in
# Admin → Data → Bundle orders until you add the key and hit "Send now".
# Generate the key in your agent dashboard: justicedatashop.com → Developer →
# Authentication → Generate API Key. It spends your agent wallet — server-only,
# never expose it to the browser.
JUSTICE_API_KEY=""
# Override only if the provider moves its API. Defaults to the URL below.
JUSTICE_API_BASE="https://backend.justicedatashop.com"

# Shared secret for the provider's order-status callback. OPTIONAL but
# recommended: when set, we register a callback URL with each order and bundle
# statuses update themselves. Without it you refresh orders by hand in the
# admin. Generate with: openssl rand -hex 32
DATA_WEBHOOK_SECRET=""
