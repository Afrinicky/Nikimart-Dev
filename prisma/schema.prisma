// NikiMart — Prisma schema (Phase 3 foundation)
// Auth.js models + application domain (users, roles, vendors, products, orders,
// pickup points, shipments). SQLite for local/dev; swap the datasource provider
// and DATABASE_URL for Postgres in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) core models
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  phone             String?
  passwordHash      String?
  // Role gates every dashboard. SQLite has no enums, so we store the role as a
  // string constrained by the Role helper in src/lib/roles.ts.
  role              String    @default("CUSTOMER")
  // Default delivery address + preferred pickup centre (set at registration).
  address           String?
  preferredPickupId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  vendor          Vendor?
  orders          Order[]
  pickupPoint     PickupPoint?         @relation("PickupOperator")
  preferredPickup PickupPoint?         @relation("PreferredPickup", fields: [preferredPickupId], references: [id], onDelete: SetNull)
  shipments       Shipment[]           @relation("FreightAgent")
  passwordResets  PasswordResetToken[]
  affiliate       Affiliate?
  dataAgent       DataAgent?
  /**
   * When this person accepted the terms at registration.
   */
  termsAcceptedAt DateTime?
  purchasesPlaced PurchaseOrder[] @relation("PurchasePlacedBy")
}

// Single-use, time-limited password-reset tokens. Only the SHA-256 hash of the
// token is stored; the raw token is delivered to the user by email/SMS.
model PasswordResetToken {
  id        String    @id @default(cuid())
  // SHA-256 hash of the 6-digit OTP (never store the code itself).
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id                      String    @id @default(cuid())
  name                    String
  slug                    String    @unique
  icon                    String
  description             String
  productCount            Int       @default(0)
  // Optional per-category commission override (percent). Null = use the
  // platform default commission rate from site settings.
  commissionRate          Float?
  // Admin-set default affiliate commission (percent of the item price) for
  // products in this category. Null = use the programme default from settings.
  // It's the rate a seller sees suggested when enrolling a product, and the
  // rate used when a product is enrolled without its own override.
  affiliateCommissionRate Float?
  products                Product[]

  // Shipping prices that single this category out.
  shippingRules    ShippingRule[]
  forwarderClasses ForwarderCategoryMap[]
}

model Vendor {
  id                       String  @id @default(cuid())
  slug                     String  @unique
  businessName             String
  // JSON-encoded string[] of SellerType values.
  sellerTypes              String  @default("[]")
  description              String
  initials                 String
  accentFrom               String
  accentTo                 String
  // JSON-encoded string[] of location ids.
  locationIds              String  @default("[]")
  // ISO-ish origin code: GH (local), CN, US, EU, AE. Non-GH = ships from abroad.
  originCountry            String  @default("GH")
  // Shop branding: a square logo and a wide cover banner (http(s) or data: URL).
  logoUrl                  String  @default("")
  bannerUrl                String  @default("")
  // Seller's WhatsApp number (any format) for the "Chat on WhatsApp" button.
  whatsapp                 String  @default("")
  verificationStatus       String  @default("pending")
  rating                   Float   @default(0)
  reviewCount              Int     @default(0)
  totalSales               Int     @default(0)
  isOfficial               Boolean @default(false)
  deliveryAvailable        Boolean @default(false)
  pickupAvailable          Boolean @default(false)
  sameDayDeliveryAvailable Boolean @default(false)

  // Where the seller wants to be paid: "" | momo | bank.
  payoutMethod      String @default("")
  momoNumber        String @default("")
  momoName          String @default("")
  bankName          String @default("")
  bankAccountName   String @default("")
  bankAccountNumber String @default("")

  // The seller's origin / consolidation hub — a pickup point where their goods
  // are gathered. It's the "from" end of every domestic shipping route. For
  // sellers abroad (originCountry != GH), goods land at the international
  // arrival hub instead and this may be null.
  originPickupId String?
  originPickup   PickupPoint? @relation("VendorOrigin", fields: [originPickupId], references: [id], onDelete: SetNull)

  // The shop's default consolidation point — where its goods are gathered and
  // checked before they are couriered to a buyer's pickup station. Set once per
  // shop so a seller listing their tenth product is not asked a tenth time; a
  // listing may still override it.
  consolidationPointId String?
  consolidationPoint   ArrivalPoint? @relation("VendorConsolidation", fields: [consolidationPointId], references: [id], onDelete: SetNull)

  ownerId String? @unique
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  products        Product[]
  payouts         Payout[]
  /**
   * When the shop owner accepted the seller policy.
   */
  termsAcceptedAt DateTime?
  purchaseOrders PurchaseOrder[]
}

// Seller settlement records. Created by admins in the Finance console to pay a
// vendor their accumulated net earnings. Kept simple: an amount, a status, and
// an optional external reference (e.g. a MoMo/bank transfer id).
model Payout {
  id        String    @id @default(cuid())
  amount    Float
  status    String    @default("pending") // pending | paid
  method    String    @default("") // e.g. MoMo, Bank
  reference String?
  note      String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// Affiliate / referral partners paid from the Finance console. Referral
// attribution is manual for now: admins record what each affiliate is owed and
// pay it out.
model Affiliate {
  id             String   @id @default(cuid())
  name           String
  phone          String   @default("")
  email          String   @default("")
  code           String?  @unique
  note           String   @default("")
  // active | suspended. Suspended affiliates stop earning on new orders.
  status         String   @default("active")
  // Optional per-affiliate commission override (percent). Null = program default.
  commissionRate Float?
  createdAt      DateTime @default(now())

  // Self-registered affiliates are linked to their user account. Admin-created
  // affiliates leave this null.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  payouts AffiliatePayout[]
  orders  Order[]
}

model AffiliatePayout {
  id        String    @id @default(cuid())
  amount    Float
  status    String    @default("pending") // pending | paid
  method    String    @default("")
  reference String?
  note      String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

model Product {
  id                       String  @id @default(cuid())
  slug                     String  @unique
  name                     String
  description              String
  price                    Float
  oldPrice                 Float?
  stockQuantity            Int     @default(0)
  // Minimum order quantity: the fewest units a buyer may order in one go.
  // Wholesale and imported listings are rarely sold one at a time, and a
  // minimum written in the description is a minimum nothing enforces.
  moq                      Int     @default(1)
  productType              String  @default("in_stock")
  // JSON-encoded string[] of BadgeKind values.
  badges                   String  @default("[]")
  // JSON-encoded string[] of location ids.
  locationIds              String  @default("[]")
  campusDeliveryAvailable  Boolean @default(false)
  pickupAvailable          Boolean @default(false)
  sameDayDeliveryAvailable Boolean @default(false)
  isOfficial               Boolean @default(false)
  isFeatured               Boolean @default(false)
  rating                   Float   @default(0)
  reviewCount              Int     @default(0)
  gradientFrom             String
  gradientTo               String
  emoji                    String
  // Billable shipping weight in kg (max of actual/volumetric) for delivery fees.
  shippingWeightKg         Float   @default(0.5)
  // Parcel dimensions in cm (used to derive the CBM when it isn't set directly).
  lengthCm                 Float   @default(0)
  widthCm                  Float   @default(0)
  heightCm                 Float   @default(0)
  // Shipping volume in cubic metres (CBM) — the basis for the shipping fee.
  // Set at listing time (directly, or auto-computed from L×W×H ÷ 1,000,000).
  cbm                      Float   @default(0)
  // Primary image (kept for backward-compat / fallback); the gallery lives in
  // ProductImage. May be an http(s) URL or a data: URL.
  image                    String?
  // JSON-encoded AbroadTerms (legacy name: PreorderInfo) / ServiceInfo
  // objects (nullable). The column keeps its old name because migrations here
  // are additive and every existing listing's terms already live in it.
  preorderInfo             String?
  serviceInfo              String?

  // --- Shipped from abroad --------------------------------------------------
  // A dropshipped listing: the seller found it on Alibaba (or anywhere), copied
  // the details, and lists it here. These columns mirror the parts of the JSON
  // terms that have to be queryable or joinable; the rest stays in preorderInfo.
  //
  // The listing's own origin, not the shop's. A seller in Accra dropshipping
  // from Guangzhou has a GH vendor and a CN product; before this, origin came
  // from the vendor alone and every such listing priced as domestic. Blank
  // falls back to the vendor's originCountry.
  originCountry   String @default("")
  // Who to buy it from when the time comes: the listing the seller copied, the
  // supplier's name, and how the buyer reaches them. All three appear on the
  // order-placement queue, so all three are columns rather than free text.
  sourceUrl       String @default("")
  supplierName    String @default("")
  supplierContact String @default("")
  // air | sea | road | express — mirrored from the chosen lane.
  freightMode     String @default("")
  // Leg 1 (GH₵ per unit): supplier → the forwarder's warehouse abroad.
  supplierFreight Float  @default(0)
  // The consolidation point this listing gathers at: the forwarder's Ghana
  // warehouse for an import, or a local point for domestic goods. The column
  // keeps its old name — every listing, order line and shipment points at it.
  arrivalPointId  String?
  arrivalPoint    ArrivalPoint? @relation(fields: [arrivalPointId], references: [id], onDelete: SetNull)

  // --- How this listing is shipped -----------------------------------------
  // auto   — priced by the shipping rules (almost everything).
  // free   — the seller absorbs it; nothing is charged to any pickup point.
  // manual — the fee is typed in. Cars, sensitive goods, anything a rate table
  //          would price wrongly: a special shipment, quoted by hand.
  shippingMethod    String            @default("auto")
  manualShippingFee Float             @default(0)
  // True when the supplier's price already puts the goods at the Ghana
  // consolidation point. Nothing is charged for the international leg; the
  // buyer pays only the local run from there to the station they choose.
  supplierDelivers  Boolean           @default(false)
  // The forwarder carrying the international leg, and the lane they carry it
  // on — mode plus the Ghana point it lands at. The lane is what prices it.
  forwarderId       String?
  forwarder         FreightForwarder? @relation(fields: [forwarderId], references: [id], onDelete: SetNull)
  forwarderRouteId  String?
  forwarderRoute    ForwarderRoute?   @relation(fields: [forwarderRouteId], references: [id], onDelete: SetNull)
  // Whether the seller lets a buyer settle the shipping at collection. The
  // goods are always paid for at checkout; only the courier run may wait.
  shippingOnPickup  Boolean           @default(false)
  // JSON-encoded array of { label, value } key attributes (spec table).
  attributes        String            @default("[]")

  // --- Affiliate programme enrolment ---------------------------------------
  // Whether this product is offered to affiliate marketers. Only enrolled
  // products appear in an affiliate's shareable catalogue and earn commission.
  affiliateEnabled        Boolean @default(false)
  // Who enrolled it, and therefore who funds the commission:
  //   "seller"   — the seller opted in; the commission comes out of their net.
  //   "admin"    — NikiMart opted in; the platform funds it out of its own
  //                commission, capped at half of it (see lib/affiliate-commission).
  //   ""         — not enrolled.
  affiliateEnrolledBy     String  @default("")
  // Commission percent of the item price paid to the referring affiliate.
  // Null = fall back to the category rate, then the programme default.
  affiliateCommissionRate Float?

  // Archived products are hidden from the storefront but keep their sales
  // history. Deleting a product that has been ordered would destroy order,
  // payout, and commission records, so those are archived instead.
  isArchived Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])

  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // http(s) URL or a data: URL (base64) for device uploads.
  url       String
  order     Int     @default(0)
}

// ---------------------------------------------------------------------------
// Fulfilment
// ---------------------------------------------------------------------------

model Order {
  id             String @id @default(cuid())
  orderNumber    String @unique
  status         String @default("pending") // pending | paid | shipped | delivered | cancelled
  subtotal       Float  @default(0)
  deliveryFee    Float  @default(0)
  total          Float  @default(0)
  deliveryMethod String @default("delivery") // delivery | pickup

  // --- Shipped-from-abroad billing -----------------------------------------
  // A domestic order is goods + delivery. An imported one is bought in another
  // country, taxed there, carried to a forwarder, freighted in, dutied and
  // taxed on landing, then moved inside Ghana. Each leg is snapshotted so the
  // bill can be shown back exactly as it was quoted, and so a later rate change
  // never silently rewrites what somebody already paid.
  hasAbroadItems       Boolean  @default(false)
  // Leg 1: supplier → the forwarder's warehouse abroad.
  supplierFreight      Float    @default(0)
  // Leg 2: forwarder → their Ghana point. (Leg 3 is deliveryFee.)
  internationalFreight Float    @default(0)
  // What the buyer chose to settle today: "full" | "goods_only". Under
  // goods_only the freight legs, duty and Ghana tax are paid when it lands —
  // and any rate rise in between is theirs.
  paymentPlan          String   @default("full")
  amountPaid           Float    @default(0)
  balanceDue           Float    @default(0)
  // True when the whole bill was settled up front, so later rate rises are
  // absorbed rather than passed on.
  freightLocked        Boolean  @default(true)
  address              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pickupPointId String?
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id])

  // Affiliate attribution: who referred this order and the commission they earn.
  affiliateId         String?
  affiliate           Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliateCommission Float      @default(0)

  items    OrderItem[]
  shipment Shipment?
}

model OrderItem {
  id             String @id @default(cuid())
  quantity       Int    @default(1)
  unitPrice      Float
  // Platform commission percent captured at sale time, so seller payouts stay
  // accurate even if the rate changes later. Seller earns unitPrice*qty*(1-rate/100).
  commissionRate Float  @default(0)

  // Affiliate commission snapshot for this line: the percent applied, the cash
  // amount, and who funds it ("seller" | "platform" | "" when there's none).
  // Snapshotted at sale time so enrolment changes never rewrite past payouts.
  affiliateCommissionRate Float  @default(0)
  affiliateCommission     Float  @default(0)
  affiliateFundedBy       String @default("")

  // Per-line snapshot of the shipped-from-abroad bill. Kept at line level as
  // well as order level because a cart can mix an imported item with a local
  // one, and a seller payout must not be computed off freight the seller never
  // charged.
  supplierFreight      Float   @default(0)
  internationalFreight Float   @default(0)
  domesticFreight      Float   @default(0)
  freightMode          String  @default("")

  // The single shipping figure the buyer was shown and agreed to. The itemised
  // columns above stay for the seller payout and the finance reports; this is
  // what was on the screen, snapshotted so a later rate change cannot rewrite
  // what somebody was charged.
  shippingFee      Float   @default(0)
  shippingMethod   String  @default("auto")
  // True when this line's shipping was left to be settled at collection.
  shippingDeferred Boolean @default(false)

  // The route the buyer chose, and the window they were promised. Snapshotted
  // like the rest of the bill: somebody who paid for air freight keeps that
  // record even if the listing later moves to sea.
  freightRouteId String?
  freightRoute   ForwarderRoute? @relation(fields: [freightRouteId], references: [id], onDelete: SetNull)
  transitMinDays Int             @default(0)
  transitMaxDays Int             @default(0)

  arrivalPointId       String?
  arrivalPoint         ArrivalPoint? @relation(fields: [arrivalPointId], references: [id], onDelete: SetNull)
  // Where this line's goods gathered before the courier run.
  consolidationPointId String?
  consolidationPoint   ArrivalPoint? @relation("ItemConsolidation", fields: [consolidationPointId], references: [id], onDelete: SetNull)

  // The purchase that covers this line, once an admin has placed it with the
  // supplier. Null = still waiting in the order-placement queue.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

model PickupPoint {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  locationName String
  address      String
  // Collection hours, shown on the public /pickup-points page. Blank falls
  // back to the site-wide businessHours setting.
  openingHours String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  operatorId String? @unique
  operator   User?   @relation("PickupOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  orders           Order[]
  preferredByUsers User[]  @relation("PreferredPickup")

  // Sellers whose origin/consolidation hub is this point.
  originVendors Vendor[]       @relation("VendorOrigin")
  // Ghana arrival points whose domestic leg starts from this point.
  arrivalHubFor ArrivalPoint[] @relation("ArrivalHub")
  // Domestic shipping rules that end at this point.
  rulesTo       ShippingRule[] @relation("RuleDest")
  // The base-fee grid: every lane that ends at this station.
  laneFeesTo    ShippingLaneFee[] @relation("LaneDest")
}

// ---------------------------------------------------------------------------
// Shipped from abroad — Ghana arrival points and their international rates
// ---------------------------------------------------------------------------

// Where goods from abroad land before the domestic leg: Tema Port, KIA's cargo
// village, a consolidator's Kumasi warehouse. Admin-configured, because the
// choice moves the bill twice — the sea rate into Tema is nothing like the air
// rate into Accra, and the domestic leg that follows starts somewhere else. The
// seller picks one of these when listing a shipped-from-abroad product.
// Where a load is gathered and checked before it moves on.
//
// Two kinds, and the difference is ownership. A **local** point is NikiMart's:
// a seller's Kumasi store, a receiving depot. An **international** point is a
// freight forwarder's own warehouse in Ghana, created on their registration
// page and usable by nobody else — which is why `forwarderId` decides the kind
// rather than a field somebody sets by hand.
model ArrivalPoint {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  city      String   @default("")
  address   String   @default("")
  // 'local' — NikiMart's own. 'international' — a forwarder's, and then
  // `forwarderId` names them.
  kind      String   @default("international")
  // Shown to sellers and buyers: what this point is for.
  note      String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The forwarder this point belongs to. Null = a NikiMart local point.
  forwarderId String?
  forwarder   FreightForwarder? @relation(fields: [forwarderId], references: [id], onDelete: Cascade)

  // The pickup point the domestic leg starts from. Null falls back to the
  // site-wide default consolidation point setting.
  hubPickupId String?
  hubPickup   PickupPoint? @relation("ArrivalHub", fields: [hubPickupId], references: [id], onDelete: SetNull)

  products   Product[]
  orderItems OrderItem[]
  shipments  Shipment[]

  // Domestic rules that start here, lanes that land here, shops and order
  // lines that gather here.
  rulesFrom      ShippingRule[]
  laneFeesFrom   ShippingLaneFee[]
  routesInto     ForwarderRoute[] @relation("RouteDestination")
  vendors        Vendor[]         @relation("VendorConsolidation")
  consolidatedIn OrderItem[]      @relation("ItemConsolidation")

  @@index([forwarderId])
}

// One lane of the base-fee grid: from one consolidation point, to one pickup
// station, what the first item costs.
//
// A single platform-wide base fee could only ever be right for one journey.
// Sunyani to Hwidiem, Accra to Sunyani and a forwarder's Sunyani warehouse to
// the Nikimart station in the same town are three different runs with three
// different costs, and the grid is where each of them is stated: origins down
// the side, pickup stations across the top, one cell each.
//
// A row that exists is a decision, including a zero — that is a lane quoted
// free. A lane with no row falls through to the rules table and then to the
// platform default, which is what a fresh install has everywhere.
model ShippingLaneFee {
  id String @id @default(cuid())

  // Both ends are required: a cell of a grid is never "anywhere".
  originPointId String
  originPoint   ArrivalPoint @relation(fields: [originPointId], references: [id], onDelete: Cascade)
  destPickupId  String
  destPickup    PickupPoint  @relation("LaneDest", fields: [destPickupId], references: [id], onDelete: Cascade)

  // What one consignment on this lane costs, before the increments. The
  // increments themselves are untouched by the grid — they stay on the rules
  // table and the platform defaults.
  //
  // Nullable, and the distinction matters: NULL is "this lane has no base fee
  // of its own", which falls through to the rules and then to the platform
  // default. Zero is a decision — this lane is free. A cell that holds only a
  // large-item rate is the case that needs the difference.
  baseFee Float?

  // Large items — a fridge, a chest freezer, a double oven — are not priced by
  // a flat base at all: they are priced by the space they take. This is GH₵ per
  // cubic metre on this lane, and `largeMinFee` is the floor under it. Zero
  // means this lane has not priced large goods, and they fall back to the
  // platform figure, then to the flat base fee — never to nothing.
  largeRatePerCbm Float @default(0)
  largeMinFee     Float @default(0)

  note      String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One cell per lane. Both columns are NOT NULL, so unlike the rules table
  // this really is expressible as a unique constraint.
  @@unique([originPointId, destPickupId])
  @@index([destPickupId])
}

// What the domestic leg costs: one scope, one price.
//
// The scope is any combination of "from this consolidation point", "to this
// pickup point" and "for this category", and every part is optional — a rule
// with none set prices everything that no sharper rule claims. The price is
// either a flat fee per item ("blenders, Kumasi to Accra, GH₵50") or a base
// plus a rate on the billable weight, which is Jumia's shape and the one a
// seller can reason about without computing cubic metres.
//
// Resolution is most-specific-first, in src/lib/shipping.ts.
model ShippingRule {
  id String @id @default(cuid())

  // Null on any of the three means "any".
  originPointId String?
  originPoint   ArrivalPoint? @relation(fields: [originPointId], references: [id], onDelete: Cascade)
  destPickupId  String?
  destPickup    PickupPoint?  @relation("RuleDest", fields: [destPickupId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // What one consignment from one seller costs on this route.
  baseFee    Float @default(0)
  // What each unit after the first adds. Zero falls back to the weight rate
  // below (per billable kilogram of a single unit), then to the platform
  // default — so rules written before the base+increment model still price.
  perUnitFee Float @default(0)
  // Legacy: a flat price per item. Read as the base fee when no base is set,
  // never multiplied by the quantity any more — that multiplication is the bug
  // this model exists to remove.
  flatFee    Float @default(0)
  // Legacy: GH₵ per billable kilogram, now used only to derive an increment.
  perKgRate  Float @default(0)

  note      String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scope uniqueness is a COALESCE index in db/migrations/0006, which Prisma
  // cannot express: NULL never equals NULL, so a plain @@unique would let the
  // same scope be stored twice.
  @@index([originPointId])
  @@index([destPickupId])
  @@index([categoryId])
}

// A freight forwarder: who collects a load abroad, consolidates it, and brings
// it to their own warehouse in Ghana.
//
// Everything about their price lives under them. They quote per cubic metre, in
// their own currency, and that quote is the whole cost of the leg — no platform
// duty, VAT or clearing charge is added on top of it, because their sheet
// already contains whatever they had to pay.
model FreightForwarder {
  id   String @id @default(cuid())
  name String
  code String @unique

  // --- Basic information ----------------------------------------------------
  // Where they are reachable in Ghana, and who to call.
  ghanaAddress String @default("")
  contactName  String @default("")
  contactPhone String @default("")
  contactEmail String @default("")

  // --- Collection abroad ----------------------------------------------------
  // The country they collect in: CN, AE, US…
  originCountry String @default("")
  // Their warehouse in that country: where a supplier dispatches goods to
  // before the consignment leaves for Ghana. Sellers are shown this.
  collectionAddress String @default("")
  collectionCity    String @default("")

  // The currency their whole rate sheet is quoted in. Converted at pricing
  // time, so correcting one exchange rate re-prices every listing on it.
  currency String @default("USD")

  note  String @default("")
  // Standing notes: the quirks that belong to their whole sheet. Shown, never
  // priced.
  terms String @default("")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Their own consolidation points in Ghana. No other forwarder uses them.
  consolidations ArrivalPoint[]
  goodsClasses   ForwarderGoodsClass[]
  categoryMap    ForwarderCategoryMap[]
  routes         ForwarderRoute[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

// A forwarder's own classes of goods — Normal, Special, Heavy-Duty — which are
// never our categories. Ours are what a shopper browses; theirs are what a
// container is priced by. These are the rows of their rate grid.
model ForwarderGoodsClass {
  id          String           @id @default(cuid())
  forwarderId String
  forwarder   FreightForwarder @relation(fields: [forwarderId], references: [id], onDelete: Cascade)
  name        String
  note        String           @default("")
  // Retired. A special levy is now a class of its own with its own rate per
  // cubic metre, so nothing reads these two. Kept because dropping a column is
  // a deliberate exercise, not a deploy — see db/migrations/README.md. Saving a
  // forwarder writes 0 and "" over whatever is in them.
  levyCbm     Float            @default(0)
  levyLabel   String           @default("")
  sortOrder   Int              @default(0)
  // The class a category with no mapping of its own falls into.
  isDefault   Boolean          @default(false)

  rates    ForwarderRouteRate[]
  mappings ForwarderCategoryMap[]

  @@unique([forwarderId, name])
  @@index([forwarderId])
}

// One of our categories, placed in one of a forwarder's classes.
model ForwarderCategoryMap {
  id           String              @id @default(cuid())
  forwarderId  String
  forwarder    FreightForwarder    @relation(fields: [forwarderId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  goodsClassId String
  goodsClass   ForwarderGoodsClass @relation(fields: [goodsClassId], references: [id], onDelete: Cascade)

  // One row per class a category falls into: a fridge is a normal good and an
  // appliance, and the forwarder charges for both. Uniqueness is therefore on
  // the three together — it was on the pair, which is what made a category
  // pickable in exactly one class.
  @@unique([forwarderId, categoryId, goodsClassId], map: "ForwarderCategoryMap_scope_key")
  @@index([forwarderId, categoryId])
  @@index([goodsClassId])
}

// One lane: one freight mode into one of the forwarder's Ghana points. A
// column in that point's rate grid.
//
// Everything that differs between "sea, 40 days" and "air, 10 days" out of the
// same warehouse lives here — the estimate, the minimum consignment they accept
// and how often purchases are placed on it.
model ForwarderRoute {
  id          String           @id @default(cuid())
  forwarderId String
  forwarder   FreightForwarder @relation(fields: [forwarderId], references: [id], onDelete: Cascade)
  // The column heading. Blank falls back to the mode's own name.
  name        String           @default("")
  // air | sea | road | express
  mode        String           @default("sea")

  // The forwarder's Ghana point this lane lands at.
  destinationPointId String?
  destinationPoint   ArrivalPoint? @relation("RouteDestination", fields: [destinationPointId], references: [id], onDelete: Cascade)

  // Blank inherits the forwarder's currency.
  currency String @default("")
  // The delivery estimate for this mode.
  minDays  Int    @default(0)
  maxDays  Int    @default(0)
  // The smallest consignment this lane accepts. Nothing under it ships.
  minCbm   Float  @default(0)

  // How often purchases are placed on this lane: weekly | biweekly | monthly |
  // dates. Internal — never shown to a buyer.
  orderFrequency       String @default("")
  orderFrequencyDetail String @default("")

  note      String  @default("")
  isActive  Boolean @default(true)
  // The lane a listing is quoted on when the seller named none.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates          ForwarderRouteRate[]
  orderItems     OrderItem[]
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([forwarderId])
  @@index([destinationPointId])
}

// One cell of the grid: what this lane charges per cubic metre for one class of
// goods. `isAvailable` false is the N/A cell — air freight that takes phones
// and nothing else says so here, and the listing form refuses the combination
// instead of quoting a price that does not exist.
model ForwarderRouteRate {
  id           String               @id @default(cuid())
  routeId      String
  route        ForwarderRoute       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  // Null = the price for everything with no row of its own.
  goodsClassId String?
  goodsClass   ForwarderGoodsClass? @relation(fields: [goodsClassId], references: [id], onDelete: Cascade)

  ratePerCbm  Float   @default(0)
  isAvailable Boolean @default(true)
  note        String  @default("")

  // Scope uniqueness is a COALESCE index in db/migrations/0007 — NULL never
  // equals NULL, so Prisma cannot express it.
  @@index([routeId])
  @@index([goodsClassId])
}

// An exchange rate, kept in one place.
//
// Freight abroad is quoted in dollars far more often than in cedis. Storing the
// converted cedi figure would mean re-typing every rate on the day the cedi
// moves; storing the quoted figure plus this means correcting one number.
model Currency {
  code      String @id
  name      String @default("")
  symbol    String @default("")
  /// What one unit of this currency is worth in GH₵.
  rateToGhs Float  @default(1)
  isActive  Boolean @default(true)
  /// Whether the scheduled refresh may overwrite the rate. Off pins it by hand.
  autoUpdate Boolean @default(true)
  /// Where the current figure came from: a provider's host, or "manual".
  source     String  @default("")
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Order placement — buying the goods from the supplier
// ---------------------------------------------------------------------------

// One purchase, placed with one supplier, covering however many customer lines
// were waiting on it.
//
// Nothing told anybody when the time was right to buy. An imported line is paid
// for and then waits: a forwarder will not ship a single pair of shoes, so the
// order is worth placing only once enough volume from the same supplier clears
// their minimum — one parcel, one consolidation, one freight bill. Only an
// admin creates these; a seller sees theirs and cannot place one.
model PurchaseOrder {
  id        String @id @default(cuid())
  reference String @unique

  // Copied off the listings at placement time, so the record survives a seller
  // later editing the listing.
  supplierName    String @default("")
  supplierUrl     String @default("")
  supplierContact String @default("")

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  forwarderId String?
  forwarder   FreightForwarder? @relation(fields: [forwarderId], references: [id], onDelete: SetNull)
  routeId     String?
  route       ForwarderRoute?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  // pending | placed | received | cancelled
  status    String @default("pending")
  totalCbm  Float  @default(0)
  totalCost Float  @default(0)
  note      String @default("")

  placedAt   DateTime?
  placedById String?
  placedBy   User?     @relation("PurchasePlacedBy", fields: [placedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([vendorId])
  @@index([forwarderId])
  @@index([routeId])
}

model Shipment {
  id                  String        @id @default(cuid())
  trackingNumber      String        @unique
  // Derived "furthest confirmed" stage: created | processing | in_transit |
  // out_for_delivery | delivered. Advanced only by role-based confirmations.
  status              String        @default("created")
  manualHold          Boolean       @default(false)
  carrier             String        @default("NikiMart Freight")
  origin              String
  destination         String
  eta                 DateTime?
  // Per-stage confirmation timestamps. A non-null value = that stage is
  // confirmed (ticked). Confirming a later stage back-fills earlier ones.
  processingAt        DateTime?
  transitAt           DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?
  // Extra milestones for a consignment coming from abroad. A domestic order
  // goes prepared → in transit → out for delivery → delivered; an imported one
  // spends weeks between "the seller has ordered it" and "it is in the country",
  // and a buyer who cannot see that stretch assumes nothing is happening.
  // forwarderReceivedAt = at the freight forwarder abroad.
  // arrivedGhanaAt      = landed and cleared at the Ghana arrival point. This
  //                       is the milestone the buyer is alerted on.
  forwarderReceivedAt DateTime?
  arrivedGhanaAt      DateTime?
  // The Ghana point this consignment lands at, when it comes from abroad.
  arrivalPointId      String?
  arrivalPoint        ArrivalPoint? @relation(fields: [arrivalPointId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  freightAgentId String?
  freightAgent   User?   @relation("FreightAgent", fields: [freightAgentId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Page builder — composable pages made of ordered section blocks.
// ---------------------------------------------------------------------------

model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  isPublished Boolean       @default(true)
  isSystem    Boolean       @default(false) // e.g. the home page can't be deleted
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sections    PageSection[]
}

model PageSection {
  id        String  @id @default(cuid())
  pageId    String
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String // hero | global_band | category_grid | product_rail | vendor_rail | campus | rich_text | banner
  order     Int     @default(0)
  isVisible Boolean @default(true)
  // JSON-encoded block config (title, subtitle, collection, tone, body, …).
  config    String  @default("{}")
}

model SiteSetting {
  key   String @id
  value String
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model Location {
  id                     String  @id @default(cuid())
  name                   String
  type                   String  @default("city") // city | town | campus | institution | community
  region                 String
  isActive               Boolean @default(true)
  order                  Int     @default(0)
  // Delivery-fee zone multiplier (1 = standard; <1 nearer/cheaper, >1 farther).
  deliveryZoneMultiplier Float   @default(1)
}

// Homepage promotional carousel slides (editable in the admin console).
model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String   @default("")
  // Event window / offer line, e.g. "TODAY | 12PM - 3PM".
  eventWindow String   @default("")
  ctaLabel    String   @default("Shop now")
  ctaHref     String   @default("/products")
  // Optional product/hero image (http(s) URL or a data: URL from an upload).
  image       String?
  // Gradient background colours for the slide card.
  accentFrom  String   @default("#ff7a1a")
  accentTo    String   @default("#0e1f36")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Data bundles — NikiMart's own internet-bundle storefront, fulfilled through
// the Justice Datashop agent API. Kept deliberately separate from the shopping
// mall's catalogue/orders so bundle stock, pricing, and fulfilment never mix
// with physical goods.
// ---------------------------------------------------------------------------

// One sellable bundle: a size on a network, at the price NikiMart charges.
// `costPrice` is what the upstream agent account is billed, so the admin can
// see the margin on every row. Prices are GH₵ (the provider quotes pesewas).
model DataBundle {
  id         String   @id @default(cuid())
  // MTN | TELECEL | AIRTELTIGO_ISHARE | AIRTELTIGO_BIGTIME (see lib/data-bundles/networks.ts).
  network    String
  // Volume in GB, as sent to the provider's `size` field.
  sizeGb     Float
  // Selling price shown on the storefront (GH₵).
  price      Float
  // Upstream cost (GH₵). 0 when unknown — margin is then just not shown.
  costPrice  Float    @default(0)
  // What NikiMart charges its own sub-agents for this bundle (GH₵). It is the
  // agent's cost basis: their commission on a storefront sale is whatever they
  // charge above this. 0 means "not resold to agents", and the bundle is then
  // hidden from agent storefronts. Set it in Admin → Data → Bundle prices.
  agentPrice Float    @default(0)
  // Optional marketing line, e.g. "No expiry · instant delivery".
  validity   String   @default("No expiry")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([network, sizeGb])
  @@index([network, isActive])
}

// A single bundle purchase. Guests can buy (no account needed), so `userId` is
// optional and the buyer is identified by phone.
model DataOrder {
  id        String @id @default(cuid())
  // Doubles as the Paystack transaction reference (ND-…), so it must be unique.
  reference String @unique

  network        String
  sizeGb         Float
  // Price charged and upstream cost, snapshotted at purchase time so later
  // price edits never rewrite past orders or the profit report.
  price          Float
  costPrice      Float   @default(0)
  // Local Ghana number the data is credited to (0XXXXXXXXX).
  recipientPhone String
  // Who bought it — for the receipt SMS and order lookup.
  buyerPhone     String
  buyerEmail     String?
  buyerName      String?

  // pending | paid | processing | completed | failed | refunded
  status        String    @default("pending")
  // unpaid | paid — payment is separate from delivery, so a paid-but-undelivered
  // order is visible to the admin as exactly that.
  paymentStatus String    @default("unpaid")
  paidAt        DateTime?

  // Upstream (Justice Datashop) references, filled in once dispatched.
  providerOrderId String?
  providerCode    String?
  providerStatus  String?
  providerMessage String?
  dispatchedAt    DateTime?
  completedAt     DateTime?

  // --- Sub-agent attribution ------------------------------------------------
  // Set when the sale came through an agent: either their public storefront or
  // the Data Topup screen inside their own dashboard.
  agentId          String?
  agent            DataAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // WEB | STOREFRONT | AGENT — where the order was placed. WEB is NikiMart's
  // own /data-bundles storefront.
  source           String     @default("WEB")
  // The agent price in force when the order was placed (the agent's cost), and
  // the commission they earn on it. Both are snapshotted so a later price edit
  // never rewrites what was owed.
  agentCost        Float      @default(0)
  agentCommission  Float      @default(0)
  // pending | earned | void. Commission is only credited once the bundle has
  // actually been delivered, so a failed order never pays out.
  commissionStatus String     @default("pending")
  commissionPaidAt DateTime?

  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerPhone])
  @@index([recipientPhone])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([agentId, createdAt])
}

// An AFA (agent SIM) registration sold through the storefront and submitted to
// the provider once paid.
model AfaRegistration {
  id        String @id @default(cuid())
  reference String @unique

  fullName    String
  phoneNumber String
  idNumber    String
  dateOfBirth String
  town        String
  occupation  String

  price         Float
  // pending | paid | processing | completed | failed
  status        String    @default("pending")
  paymentStatus String    @default("unpaid")
  paidAt        DateTime?

  providerId      String?
  providerStatus  String?
  providerMessage String?
  dispatchedAt    DateTime?
  completedAt     DateTime?

  // Sub-agent attribution, exactly as on DataOrder.
  agentId          String?
  agent            DataAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  source           String     @default("WEB")
  agentCost        Float      @default(0)
  agentCommission  Float      @default(0)
  commissionStatus String     @default("pending")
  commissionPaidAt DateTime?

  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
  @@index([agentId, createdAt])
}

// ---------------------------------------------------------------------------
// Sub-agent platform — NikiMart resells to its own agents exactly as Justice
// Datashop resells to NikiMart. An agent opens a storefront, sets their own
// retail prices on top of the agent price NikiMart charges them, and earns the
// difference as commission once each order is delivered.
//
// Agents never stock a wallet: every sale is paid by the customer through
// Paystack at the moment of purchase. The only money that moves into an agent
// account is commission, and the only money out is a MoMo withdrawal.
// ---------------------------------------------------------------------------

model DataAgent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Human-friendly agent code, e.g. "NKM4821" — shown on the dashboard and
  // quoted in support.
  code String @unique

  // The storefront. `slug` is the public path segment: /store/<slug>.
  slug         String  @unique
  storeName    String
  // Short line under the store name on the public storefront.
  storeTagline String  @default("")
  storeAbout   String  @default("")
  // "open" hides nothing; "closed" shows a closed notice instead of the grid.
  storeOpen    Boolean @default(true)

  supportPhone    String @default("")
  supportWhatsapp String @default("")
  whatsappGroup   String @default("")

  // The agent's own AFA registration price. 0 means "use NikiMart's price"
  // (and earn nothing on it); afaEnabled hides AFA from their storefront.
  afaPrice   Float   @default(0)
  afaEnabled Boolean @default(true)

  // active | suspended. A suspended agent keeps their balance and history but
  // their storefront stops selling and they stop earning.
  status String @default("active")

  // Running balance in GH₵. Opens negative — the storefront setup fee is
  // charged the moment the store is created — and climbs back through zero as
  // commissions land. Only a positive balance can be withdrawn.
  balance  Float @default(0)
  // What the store cost to open, kept for the ledger narration and for the
  // "still to clear" line on the wallet.
  setupFee Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices      DataAgentPrice[]
  ledger      DataAgentLedger[]
  withdrawals DataAgentWithdrawal[]
  orders      DataOrder[]
  afa         AfaRegistration[]

  @@index([status])
}

// An agent's own retail price for one bundle. Absent = the agent sells that
// bundle at NikiMart's agent price (zero commission) — present and inactive =
// the bundle is hidden from their storefront entirely.
model DataAgentPrice {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  network  String
  sizeGb   Float
  // What the agent charges their customer (GH₵). Must be ≥ the agent price.
  price    Float
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, network, sizeGb])
  @@index([agentId, isActive])
}

// Every movement on an agent's balance, newest first on the wallet screen.
// Balances are only ever changed by writing one of these rows, so the ledger
// and the balance can always be reconciled against each other.
model DataAgentLedger {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // SETUP_FEE | COMMISSION | WITHDRAWAL | WITHDRAWAL_REVERSAL | ADJUSTMENT
  type         String
  // Signed GH₵: negative debits the agent, positive credits them.
  amount       Float
  // Balance after this entry was applied, so history never has to be replayed.
  balanceAfter Float
  narration    String  @default("")
  // The order / withdrawal / admin action this entry came from.
  reference    String?

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([reference])
}

// A commission withdrawal to MoMo. Admins process these by hand from the
// data console, exactly as Justice does.
model DataAgentWithdrawal {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // What the agent receives on MoMo.
  amount Float
  // Flat platform fee added on top and debited with the payout.
  fee    Float @default(0)

  momoPhone   String
  momoName    String
  momoNetwork String

  // pending | processed | rejected
  status      String    @default("pending")
  adminNote   String    @default("")
  processedBy String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([status])
}

// Broadcast announcements shown to agents (Justice's Notifications screen).
model DataAnnouncement {
  id       String  @id @default(cuid())
  title    String
  body     String
  // info | warning | success — drives the accent on the notice card.
  tone     String  @default("info")
  isActive Boolean @default(true)
  // Pinned notices sort above the rest regardless of date.
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

// A callback request raised from the agent Support screen.
model DataSupportRequest {
  id       String  @id @default(cuid())
  agentId  String?
  fullName String
  phone    String
  language String  @default("English")
  message  String

  // open | resolved
  status     String    @default("open")
  adminNote  String    @default("")
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/**
 * An application to become an agent.
 * Signup is an application, not an instant account: someone gives their name,
 * contact, email and the store name they want, and an admin approves it. That
 * ordering matters — the store slug is a public URL and the agent's identity to
 * their customers, so it gets a human look before it exists, and NikiMart
 * chooses who resells under its name.
 * Approving provisions the User and the DataAgent and issues a one-time setup
 * link, so no password is collected here — nothing worth stealing sits in this
 * table while it waits.
 */
model DataAgentApplication {
  id String @id @default(cuid())

  fullName    String
  phone       String
  email       String
  /**
   * The store name they typed, exactly as they typed it.
   */
  storeName   String @default("")
  /**
   * The store link they asked for, already normalised.
   */
  desiredSlug String
  /**
   * Optional note from the applicant.
   */
  note        String @default("")

  // pending | approved | rejected
  status     String    @default("pending")
  reviewedBy String?
  reviewedAt DateTime?
  /**
   * Why it was rejected, shown to the applicant if they ask.
   */
  adminNote  String    @default("")

  /**
   * SHA-256 of the one-time setup token, never the token itself. Set on
   * approval and cleared once the agent has chosen a password.
   */
  setupTokenHash String?
  setupExpiresAt DateTime?
  /**
   * The account created on approval, once it exists.
   */
  agentId        String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /**
   * When the applicant accepted the agent policy.
   */
  termsAcceptedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
  @@index([desiredSlug])
}

/**
 * One fixed rate-limit window.
 * In the database rather than in memory because the app runs serverless: a
 * process-local counter is per-instance, so "8 attempts" is really "8 per warm
 * lambda" and spreading requests across instances buys an attacker as many
 * multiples as the platform will start. One row, incremented by one atomic
 * statement, is the same limit however many instances are running.
 */
model RateLimit {
  /**
   * The bucket: an action plus whatever identifies the caller.
   */
  key     String   @id
  count   Int      @default(1)
  /**
   * When this window ends and the count starts again.
   */
  resetAt DateTime

  @@index([resetAt])
}

/**
 * A published policy — terms, privacy, returns, the agent and seller policies.
 * A row exists only once an admin has edited that policy; until then the page
 * publishes the built-in text in lib/legal.ts. That way a fresh database has
 * complete policies rather than empty ones, and editing is a save rather than
 * a deploy — which matters for a document people must accept to register.
 */
model LegalPolicy {
  slug  String @id
  title String
  intro String @default("")
  /**
   * The whole document; `## ` starts a section.
   */
  body  String

  updatedAt DateTime @updatedAt
  updatedBy String   @default("")
}
