// Nickimart Medical — medical and laboratory supplies database.
//
// The third business in this repository, and the third database. Retail lives
// in prisma/schema.prisma, data bundles in prisma/data/schema.prisma, and this
// is medicals.nickimart.com: a catalogue of reagents, consumables, diagnostics
// and equipment, the quotation workflow that most of that catalogue is actually
// sold through, and the inventory, sourcing and financial records behind it.
//
// Why separate, again
// -------------------
// The same reasoning the bundle split was made on. A procurement business keeps
// different records, fails differently and is restored differently from a mall:
// a quotation issued three weeks ago must still read exactly as it was issued
// even if every price in the catalogue has moved since, and a restore of the
// mall must never roll a sales ledger back. MEDICAL_DATABASE_URL points here;
// when it isn't set the client falls back to DATABASE_URL so an environment
// that hasn't been split yet still runs (see src/lib/medical/db.ts).
//
// Identity crosses, nothing else
// ------------------------------
// A customer signs in with their Nickimart account, so MedicalCustomer.userId
// and MedicalStaff.userId hold a User.id from the retail database as a plain,
// indexed column — not a foreign key, because Postgres cannot enforce a
// reference into another database. src/lib/medical/user-link.ts joins the two
// sides in one round trip for a whole page of rows, exactly as the bundle
// business does it.
//
// Money
// -----
// Every amount is Decimal(14,2) and every calculation happens in integer
// pesewas (src/lib/medical/money.ts). The retail schema stores money as Float,
// which is fine for a single item price and wrong for a twenty-line quotation
// with a line discount, a delivery charge and an instalment uplift — the errors
// compound, and the total on a document a customer signs has to be exact.
// Percentages are Decimal(7,4): 12.5% is 12.5000, and a rate is never rounded
// before it is applied.

generator client {
  provider = "prisma-client-js"
  // Its own output directory. Three clients generated to the same default path
  // would overwrite one another and the app would import the wrong schema's
  // types — the bundle schema hit exactly this and solved it the same way.
  output   = "../../node_modules/.prisma/medical-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MEDICAL_DATABASE_URL")
}

// ===========================================================================
// People
// ===========================================================================

/// A member of staff in the medical admin console.
///
/// Separate from the retail Role enum because the jobs are different: the
/// person who prices a quotation is rarely the person who receives goods, and
/// neither should be able to edit payment plans. userId is a retail User.id.
model MedicalStaff {
  id     String @id @default(cuid())
  /// Retail User.id. Plain column — see the note at the head of this file.
  userId String @unique
  /// Denormalised so the console can list and search staff without crossing
  /// databases on every render. Refreshed from the retail user on sign-in.
  name   String @default("")
  email  String @default("")
  phone  String @default("")

  /// OWNER | MANAGER | SALES | PROCUREMENT | STORES | FINANCE | SUPPORT
  /// Checked in src/lib/medical/roles.ts, which also maps a role to the console
  /// sections it may reach. A string rather than an enum so a role can be added
  /// without a migration, validated in one place on the way in.
  role      String  @default("SALES")
  isActive  Boolean @default(true)
  /// Free-text note for the person who deactivated them, shown in the console.
  statusNote String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedQuotations QuotationRequest[] @relation("QuotationAssignee")
  issuedQuotations   Quotation[]        @relation("QuotationIssuer")
  auditLogs          MedicalAuditLog[]
  stockMovements     StockMovement[]
  posSales           SalesOrder[]       @relation("PosOperator")

  @@index([role, isActive])
  @@map("medical_staff")
}

/// An institution that buys: a hospital, a laboratory, a clinic, a university
/// department. Individuals buy without one.
///
/// Institutions are the reason the quotation system exists. A laboratory does
/// not add a centrifuge to a cart; it asks for a quotation, takes it to whoever
/// signs, and comes back weeks later expecting the price to hold. Everything
/// here exists to make that document correct and to let more than one person at
/// the institution act on it.
model Organisation {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// HOSPITAL | LABORATORY | CLINIC | PHARMACY | RESEARCH | ACADEMIC |
  /// GOVERNMENT | NGO | DISTRIBUTOR | OTHER
  kind String @default("LABORATORY")

  /// What they do, in their words. Shown to the person pricing their quotation.
  about        String @default("")
  /// Business registration / TIN. Needed on a proforma invoice an institution
  /// will submit to its own finance office.
  registrationNo String @default("")
  taxId          String @default("")

  email   String @default("")
  phone   String @default("")
  website String @default("")

  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  region       String @default("")
  country      String @default("Ghana")
  digitalAddress String @default("")

  /// Whether this institution may be offered instalment terms at all, and how
  /// much unpaid balance it may carry. Set by finance, not by the customer.
  creditApproved  Boolean @default(false)
  creditLimit     Decimal @default(0) @db.Decimal(14, 2)
  /// Default payment terms offered to this institution, overriding the global
  /// default on a new quotation. Blank means use the global default.
  defaultPaymentTerms String @default("")

  /// Set by an administrator after checking the institution is real. Nothing in
  /// the storefront claims verification; this gates credit and nothing else.
  isVerified Boolean  @default(false)
  verifiedAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           OrganisationMember[]
  customers         MedicalCustomer[]
  addresses         CustomerAddress[]
  quotationRequests QuotationRequest[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]

  @@index([kind, isActive])
  @@map("medical_organisations")
}

/// Somebody's seat at an institution, and what they may do with it.
///
/// A laboratory technician may ask for a quotation; only the person holding the
/// budget may accept one. Without this distinction an accepted quotation means
/// nothing, because anyone who could see it could accept it.
model OrganisationMember {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       MedicalCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// ADMIN   — manages the institution's members and settles accounts.
  /// BUYER   — may accept a quotation and place an order.
  /// REQUESTER — may request a quotation, and nothing else.
  /// VIEWER  — may read the institution's history.
  role String @default("REQUESTER")

  /// A ceiling on what this member may commit the institution to in one order,
  /// in GH₵. Zero means no ceiling of their own — the institution's limit
  /// applies. Enforced server-side at acceptance and at checkout.
  approvalLimit Decimal @default(0) @db.Decimal(14, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, customerId])
  @@index([customerId])
  @@map("medical_organisation_members")
}

/// A buyer. Backed by a Nickimart account; may belong to one or more
/// institutions, or to none.
model MedicalCustomer {
  id     String @id @default(cuid())
  /// Retail User.id. Plain column — see the note at the head of this file.
  userId String @unique

  /// Denormalised from the retail user so lists, search and documents do not
  /// cross databases per row. Refreshed on sign-in and on profile save.
  name  String @default("")
  email String @default("")
  phone String @default("")

  /// INDIVIDUAL | HOSPITAL | LABORATORY | CLINIC | PHARMACY | RESEARCH |
  /// ACADEMIC | GOVERNMENT | NGO | DISTRIBUTOR | OTHER
  /// Their own description of themselves, asked once at registration. It
  /// decides which fields the quotation form asks for and nothing else.
  customerType String @default("INDIVIDUAL")

  /// Their primary institution, when they have one. The full set of
  /// institutions they may act for is in OrganisationMember; this is the one
  /// pre-selected on a new request.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  /// Profession or role, free text — "Chief Biomedical Scientist". Printed on a
  /// quotation when supplied, because the person pricing it reads it.
  jobTitle String @default("")

  /// Whether they agreed to hear about new stock. Nothing is sent without it.
  marketingOptIn Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganisationMember[]
  addresses         CustomerAddress[]
  quotationRequests QuotationRequest[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  wishlist          WishlistItem[]
  supportRequests   SupportRequest[]

  @@index([customerType, isActive])
  @@index([organisationId])
  @@map("medical_customers")
}

/// A delivery or billing address. Belongs to a person, an institution, or both.
model CustomerAddress {
  id String @id @default(cuid())

  customerId String?
  customer   MedicalCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// What to call it in a list: "Main laboratory", "Stores entrance".
  label String @default("")

  contactName  String @default("")
  contactPhone String @default("")

  addressLine1   String @default("")
  addressLine2   String @default("")
  city           String @default("")
  region         String @default("")
  country        String @default("Ghana")
  digitalAddress String @default("")
  /// Where the gate is, which bell to press, which ward. Deliveries of cold
  /// chain goods fail on exactly this.
  deliveryNotes  String @default("")

  isDefaultDelivery Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrdersDelivery SalesOrder[] @relation("DeliveryAddress")
  salesOrdersBilling  SalesOrder[] @relation("BillingAddress")

  @@index([customerId])
  @@index([organisationId])
  @@map("medical_customer_addresses")
}

// ===========================================================================
// Catalogue
// ===========================================================================

/// A catalogue category. Nests one level or many; ordered by hand.
model MedicalCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @default("")
  /// A lucide icon name, resolved through src/lib/medical/icons.ts. A string so
  /// an administrator can change it without a deploy.
  icon        String  @default("FlaskConical")
  /// Shown on the category page header and in the sidebar hover card.
  image       String?

  parentId String?
  parent   MedicalCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MedicalCategory[] @relation("CategoryTree")

  /// Hand-set order within the parent. Gaps are deliberate: reordering writes
  /// new positions rather than renumbering every sibling.
  position Int     @default(0)
  isActive Boolean @default(true)
  /// Shown in the homepage sidebar. A catalogue has more categories than a
  /// sidebar has room for.
  showInSidebar Boolean @default(true)

  metaTitle       String @default("")
  metaDescription String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products MedicalProduct[]

  @@index([parentId, position])
  @@index([isActive, position])
  @@map("medical_categories")
}

/// A manufacturer or brand. Separate from supplier: a customer may filter by
/// Roche, and must never learn who Nickimart buys Roche from.
model Manufacturer {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  country     String  @default("")
  logo        String?
  description String  @default("")
  website     String  @default("")

  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products MedicalProduct[]

  @@map("medical_manufacturers")
}

/// A catalogue item.
///
/// Public and private fields live in one row, which means no query on a
/// customer-facing surface may select the whole row. src/lib/medical/catalogue.ts
/// exports PUBLIC_PRODUCT_SELECT and every storefront read goes through it; the
/// private columns are grouped below and marked, so the rule is visible to
/// whoever edits this file next.
model MedicalProduct {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  /// One line under the name in a card and at the top of the detail page.
  summary     String @default("")
  description String @default("")

  categoryId String
  category   MedicalCategory @relation(fields: [categoryId], references: [id])

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  /// The manufacturer's own catalogue number. The single most useful field on
  /// this whole model: a laboratory orders "Roche 04489357190", not "glucose
  /// reagent". Indexed, and searched before the name.
  catalogueNumber String @default("")
  /// Nickimart's internal SKU.
  sku             String @unique

  /// How it is sold: "Pack of 100", "500 mL bottle", "Case of 10 × 1 L".
  packSize String @default("")
  /// The noun on the line of a quotation: pack, box, bottle, piece, case, kit.
  unitOfSale String @default("unit")
  /// How many individual items are in one unit of sale, when that is a sensible
  /// number. Zero where it is not (a 500 mL bottle has no count).
  unitsPerPack Int @default(0)

  // --- Pricing (public) -----------------------------------------------------
  /// The listed price of one unit of sale, outright, before any charge.
  price         Decimal  @db.Decimal(14, 2)
  /// A struck-through former price, when there is one. Null, never zero.
  comparePrice  Decimal? @db.Decimal(14, 2)
  currency      String   @default("GHS")
  /// Fewest units one order may contain.
  minimumOrderQuantity Int @default(1)

  // --- PRIVATE. Never selected by a customer- or redistributor-facing query --
  /// What Nickimart pays for one unit of sale, most recently. The running
  /// history is in ProductCostHistory; this is the figure margin is computed
  /// against and the default cost on a new purchase order line.
  purchaseCost      Decimal @default(0) @db.Decimal(14, 2)
  /// Weighted average cost across the batches currently in stock. Maintained by
  /// goods-received postings; the basis for stock valuation and COGS.
  averageCost       Decimal @default(0) @db.Decimal(14, 2)
  /// The supplier this is normally bought from.
  primarySupplierId String?
  primarySupplier   Supplier? @relation(fields: [primarySupplierId], references: [id], onDelete: SetNull)
  /// LOCAL | IMPORT | BOTH — how it is sourced. Drives lead-time defaults and
  /// whether landed costs are asked for on a purchase order.
  sourcingMode      String  @default("LOCAL")
  /// Anything the buyer needs to know that no customer should see: the agent in
  /// Guangzhou, the minimum the supplier will ship, the last price argument.
  internalNotes     String  @default("")
  // --- end private ----------------------------------------------------------

  /// CHECKOUT | QUOTATION | BOTH. Whether a customer may buy this directly, must
  /// ask for a quotation, or may choose. Changed by an administrator at any
  /// time; nothing about it is compiled in.
  purchaseMode String @default("BOTH")

  // --- Stock ----------------------------------------------------------------
  /// Units physically in the store. Never decremented directly — every change
  /// goes through a StockMovement inside a transaction, so the row and the
  /// movement log can never disagree.
  stockOnHand  Int @default(0)
  /// Units spoken for by an accepted quotation or an unfulfilled order.
  /// Available = stockOnHand − stockReserved.
  stockReserved Int @default(0)
  /// Units on an open purchase order, not yet received.
  stockOnOrder Int @default(0)
  /// Below this, the console flags it for reordering.
  reorderLevel Int @default(0)
  /// How many to buy when it is reordered.
  reorderQuantity Int @default(0)
  /// Whether a customer may order more than is in stock. True for a catalogue
  /// item always brought in to order; false for anything sold from the shelf.
  allowBackorder Boolean @default(false)
  /// Whether this item is tracked by batch and expiry at all. Reagents are;
  /// a stainless steel forceps is not.
  tracksBatches Boolean @default(false)

  /// Working days from order to delivery, as shown to a customer. A range
  /// because sourcing is a range; both ends shown when they differ.
  leadTimeMinDays Int @default(2)
  leadTimeMaxDays Int @default(7)

  // --- Handling -------------------------------------------------------------
  /// AMBIENT | COOL | REFRIGERATED | FROZEN | CONTROLLED
  storageCondition String @default("AMBIENT")
  /// "Store at 2–8 °C. Do not freeze." Printed on the delivery note.
  handlingNotes    String @default("")
  /// Whether moving it needs a cold chain. Shown on the product page, because a
  /// customer in Tamale needs to know before they order.
  requiresColdChain Boolean @default(false)
  /// Dangerous goods class, blank when not applicable.
  hazardClass       String @default("")

  /// Whether a customer must show a licence or an institutional account before
  /// this can be sold to them. Controlled substances and prescription devices.
  restrictedSale Boolean @default(false)
  /// What they must show, in words, for the person reviewing the order.
  restrictionNote String @default("")

  /// Technical specifications, as [{ label, value }]. JSON rather than a table
  /// because they are read as a block, written as a block, and never queried.
  specifications String @default("[]")
  /// Analysers or methods this is verified to work with, as string[]. Only
  /// what the manufacturer states — an unverified compatibility claim on a
  /// reagent is how a laboratory loses a run.
  compatibleWith String @default("[]")
  /// Documents: [{ label, url, kind }] — insert, SDS, certificate of analysis.
  documents      String @default("[]")

  /// Search keywords an administrator adds: trade names, misspellings, the
  /// local word for it. Appended to the search vector, never displayed.
  searchTerms String @default("")

  /// DRAFT | ACTIVE | OUT_OF_STOCK | DISCONTINUED | ARCHIVED.
  /// Archived rather than deleted: a product that has been quoted or sold
  /// cannot be removed without destroying the documents that reference it.
  status String @default("DRAFT")

  isFeatured Boolean @default(false)
  /// Shown in the "new arrivals" rail until an administrator clears it.
  isNewArrival Boolean @default(false)
  /// Hand-set ordering within a category listing.
  position Int @default(0)

  metaTitle       String @default("")
  metaDescription String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images             MedicalProductImage[]
  batches            StockBatch[]
  stockMovements     StockMovement[]
  quotationRequestItems QuotationRequestItem[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  supplierQuoteItems SupplierQuoteItem[]
  costHistory        ProductCostHistory[]
  wishlistedBy       WishlistItem[]
  commissions        RedistributorCommission[]

  @@index([categoryId, status, position])
  @@index([status, isFeatured])
  @@index([catalogueNumber])
  @@index([manufacturerId])
  @@index([primarySupplierId])
  @@map("medical_products")
}

model MedicalProductImage {
  id        String @id @default(cuid())
  productId String
  product   MedicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  /// Describes the image for somebody who cannot see it. Required in the form;
  /// a catalogue of unlabelled bottles is unusable with a screen reader.
  alt      String @default("")
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("medical_product_images")
}

model WishlistItem {
  id         String @id @default(cuid())
  customerId String
  customer   MedicalCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    MedicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@map("medical_wishlist_items")
}

// ===========================================================================
// Suppliers and purchasing
// ===========================================================================

/// Who Nickimart buys from. Entirely internal — no customer-facing query ever
/// touches this table.
model Supplier {
  id   String @id @default(cuid())
  code String @unique
  name String

  /// LOCAL | INTERNATIONAL
  kind    String @default("LOCAL")
  country String @default("Ghana")
  /// The currency their prices are quoted in. Converted at the rate recorded on
  /// each purchase order, never at today's rate.
  currency String @default("GHS")

  contactName  String @default("")
  email        String @default("")
  phone        String @default("")
  website      String @default("")
  addressLine1 String @default("")
  city         String @default("")
  region       String @default("")

  /// Days from purchase order to goods at the Nickimart store.
  leadTimeDays Int @default(14)
  /// What they will not ship below, in their currency.
  minimumOrderValue Decimal @default(0) @db.Decimal(14, 2)
  /// Days of credit they extend. Zero means payment with order.
  paymentTermsDays  Int @default(0)
  /// Bank or momo details for settling invoices, free text.
  paymentDetails    String @default("")

  /// A buyer's note: reliability, who to call, what they are slow at.
  notes String @default("")
  /// 0–5, set by the buyer by hand. Not shown anywhere a customer can reach.
  rating Int @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products        MedicalProduct[]
  supplierQuotes  SupplierQuote[]
  purchaseOrders  PurchaseOrder[]
  invoices        SupplierInvoice[]
  payments        SupplierPayment[]
  batches         StockBatch[]
  costHistory     ProductCostHistory[]

  @@index([kind, isActive])
  @@map("medical_suppliers")
}

/// A price a supplier has given, valid until it isn't.
///
/// The reason a quotation can sit in "awaiting supplier pricing": somebody has
/// written to three suppliers and is waiting. Recording the replies here means
/// the next quotation for the same item does not need the same three emails.
model SupplierQuote {
  id         String @id @default(cuid())
  reference  String @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// DRAFT | REQUESTED | RECEIVED | EXPIRED | SUPERSEDED
  status String @default("REQUESTED")

  requestedAt DateTime @default(now())
  receivedAt  DateTime?
  validUntil  DateTime?

  currency     String  @default("GHS")
  /// The rate used to convert this supplier's currency to GH₵, recorded at the
  /// moment the quote was entered. A landed cost computed at today's rate and a
  /// price quoted at last month's rate is how margin quietly disappears.
  exchangeRate Decimal @default(1) @db.Decimal(14, 6)

  notes       String @default("")
  attachment  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SupplierQuoteItem[]

  @@index([supplierId, status])
  @@map("medical_supplier_quotes")
}

model SupplierQuoteItem {
  id              String @id @default(cuid())
  supplierQuoteId String
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)

  productId String?
  product   MedicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// What the supplier called it. Kept even when matched to a product, because
  /// the supplier's wording is what the invoice will say.
  description String
  /// Their catalogue number, which is often not ours.
  supplierSku String @default("")

  quantity  Int     @default(1)
  unitCost  Decimal @db.Decimal(14, 2)
  /// In the supplier's currency. unitCost × exchangeRate gives GH₵.
  leadTimeDays Int  @default(0)
  notes     String  @default("")

  @@index([supplierQuoteId])
  @@index([productId])
  @@map("medical_supplier_quote_items")
}

/// An order placed on a supplier.
model PurchaseOrder {
  id         String @id @default(cuid())
  reference  String @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// DRAFT | SENT | CONFIRMED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  status String @default("DRAFT")

  orderedAt       DateTime?
  expectedAt      DateTime?
  /// Set when the last outstanding line is received.
  completedAt     DateTime?

  currency     String  @default("GHS")
  /// Locked at the moment the order is sent. Every figure on this order and
  /// every cost it posts to inventory uses this rate and no other.
  exchangeRate Decimal @default(1) @db.Decimal(14, 6)

  /// Goods value, in the supplier's currency, before anything below.
  subtotal Decimal @default(0) @db.Decimal(14, 2)

  // --- Landed costs ---------------------------------------------------------
  // Each has an estimate and a confirmed figure, because they arrive months
  // apart and the difference between them is the difference between a planned
  // margin and a real one. Reports that mix the two are reports nobody trusts.
  shippingEstimate Decimal @default(0) @db.Decimal(14, 2)
  shippingActual   Decimal @default(0) @db.Decimal(14, 2)
  dutyEstimate     Decimal @default(0) @db.Decimal(14, 2)
  dutyActual       Decimal @default(0) @db.Decimal(14, 2)
  clearingEstimate Decimal @default(0) @db.Decimal(14, 2)
  clearingActual   Decimal @default(0) @db.Decimal(14, 2)
  otherEstimate    Decimal @default(0) @db.Decimal(14, 2)
  otherActual      Decimal @default(0) @db.Decimal(14, 2)
  /// True once every actual above has been entered and the order's landed cost
  /// is final. Until then reports label this order's cost as estimated.
  costsConfirmed   Boolean @default(false)

  /// subtotal + landed costs, converted at exchangeRate. Written by the server
  /// on every save so reports never recompute it from parts that have moved.
  totalLandedGhs Decimal @default(0) @db.Decimal(14, 2)

  notes       String @default("")
  createdById String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]
  invoices  SupplierInvoice[]

  @@index([supplierId, status])
  @@index([status, expectedAt])
  @@map("medical_purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String?
  product   MedicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  supplierSku String @default("")

  quantity         Int     @default(1)
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(14, 2)
  lineTotal        Decimal @default(0) @db.Decimal(14, 2)

  /// This line's share of the order's landed costs, apportioned by value when
  /// the order is costed. What actually lands in the batch's unit cost.
  landedUnitCostGhs Decimal @default(0) @db.Decimal(14, 2)

  notes String @default("")

  receiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("medical_purchase_order_items")
}

/// Goods arriving. One purchase order may be received in several deliveries.
model GoodsReceipt {
  id              String @id @default(cuid())
  reference       String @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  receivedAt   DateTime @default(now())
  receivedById String   @default("")
  /// The supplier's delivery note or waybill number.
  deliveryNote String   @default("")
  notes        String   @default("")

  createdAt DateTime @default(now())

  items GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("medical_goods_receipts")
}

model GoodsReceiptItem {
  id             String @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)

  quantityAccepted Int @default(0)
  /// Arrived broken, short-dated, or the wrong thing. Never enters stock;
  /// recorded so the claim against the supplier has a number behind it.
  quantityRejected Int @default(0)
  rejectionReason  String @default("")

  batchNumber String?
  expiryDate  DateTime?

  /// The batch this created, when it created one.
  stockBatchId String?

  @@index([goodsReceiptId])
  @@map("medical_goods_receipt_items")
}

/// What a supplier has billed, and what is still owed on it.
model SupplierInvoice {
  id         String @id @default(cuid())
  reference  String @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  /// Their invoice number, which is the one they will quote on the phone.
  supplierReference String @default("")

  /// DRAFT | AWAITING_PAYMENT | PARTIALLY_PAID | PAID | DISPUTED | CANCELLED
  status String @default("AWAITING_PAYMENT")

  issuedAt DateTime  @default(now())
  dueAt    DateTime?

  currency     String  @default("GHS")
  exchangeRate Decimal @default(1) @db.Decimal(14, 6)
  amount       Decimal @db.Decimal(14, 2)
  amountGhs    Decimal @default(0) @db.Decimal(14, 2)
  amountPaid   Decimal @default(0) @db.Decimal(14, 2)

  notes      String @default("")
  attachment String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SupplierPayment[]

  @@index([supplierId, status])
  @@index([status, dueAt])
  @@map("medical_supplier_invoices")
}

model SupplierPayment {
  id         String @id @default(cuid())
  reference  String @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierInvoiceId String?
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)

  paidAt   DateTime @default(now())
  /// BANK | MOMO | CASH | CARD | OTHER
  method   String   @default("BANK")
  currency String   @default("GHS")
  exchangeRate Decimal @default(1) @db.Decimal(14, 6)
  amount    Decimal @db.Decimal(14, 2)
  amountGhs Decimal @default(0) @db.Decimal(14, 2)

  note        String @default("")
  recordedById String @default("")

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@index([supplierInvoiceId])
  @@map("medical_supplier_payments")
}

/// What each product has cost over time, and from whom.
///
/// Written on every goods receipt. Margin on a sale made in March is computed
/// against what the goods cost in March, not against what the same thing costs
/// today — without this, a price rise retroactively rewrites last quarter's
/// profit.
model ProductCostHistory {
  id        String @id @default(cuid())
  productId String
  product   MedicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// The landed cost of one unit of sale, in GH₵.
  unitCost  Decimal  @db.Decimal(14, 2)
  currency  String   @default("GHS")
  exchangeRate Decimal @default(1) @db.Decimal(14, 6)
  quantity  Int      @default(0)
  /// GOODS_RECEIPT | MANUAL | OPENING_BALANCE
  source    String   @default("GOODS_RECEIPT")
  note      String   @default("")
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("medical_product_cost_history")
}

// ===========================================================================
// Inventory
// ===========================================================================

/// A batch of a product, with what it cost and when it expires.
///
/// Reagents are consumed oldest-first and a short-dated batch is a loss waiting
/// to happen, so stock is held per batch rather than as one number. Products
/// with tracksBatches = false get a single implicit batch and never look at it.
model StockBatch {
  id        String @id @default(cuid())
  productId String
  product   MedicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchNumber String @default("")
  expiryDate  DateTime?

  quantityReceived  Int @default(0)
  quantityRemaining Int @default(0)

  /// Landed cost of one unit in this batch. Stock valuation sums
  /// quantityRemaining × unitCost across batches.
  unitCost Decimal @default(0) @db.Decimal(14, 2)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Which goods receipt created it, for tracing a recall back to a delivery.
  goodsReceiptItemId String?

  receivedAt DateTime @default(now())
  /// Pulled from sale for a reason: recalled, damaged, quarantined pending a
  /// certificate. Quarantined stock is physically present and not sellable, so
  /// it counts in valuation and not in availability.
  isQuarantined    Boolean @default(false)
  quarantineReason String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([productId, expiryDate])
  @@index([productId, quantityRemaining])
  @@map("medical_stock_batches")
}

/// Every change to stock, append-only.
///
/// Nothing anywhere writes MedicalProduct.stockOnHand on its own: a movement is
/// inserted and the counter updated in the same transaction. The log is
/// therefore always a complete explanation of the counter, which is the only
/// way an inventory discrepancy can ever be investigated rather than argued
/// about.
model StockMovement {
  id        String @id @default(cuid())
  productId String
  product   MedicalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId   String?
  batch     StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  /// RECEIPT | SALE | POS_SALE | RESERVATION | RELEASE | DISPATCH | RETURN |
  /// DAMAGE | EXPIRY | ADJUSTMENT | TRANSFER | OPENING
  kind String

  /// Signed. Positive adds to the figure this movement affects, negative takes
  /// from it. A reservation moves units from available to reserved without
  /// touching stockOnHand, so it carries a quantity of 0 and a reservedDelta.
  quantity      Int @default(0)
  reservedDelta Int @default(0)

  /// What the counter read after this movement. Stored rather than derived so
  /// the log can be read straight down without summing from the beginning, and
  /// so a disagreement between log and counter is visible at the row it began.
  balanceAfter Int @default(0)

  /// What caused it: a sales order, a quotation, a goods receipt, a POS sale.
  /// A loose pair rather than six nullable foreign keys — the referenced tables
  /// have nothing else in common, and a movement must survive its cause being
  /// archived.
  sourceType String @default("")
  sourceId   String @default("")

  reason String @default("")
  staffId String?
  staff   MedicalStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([sourceType, sourceId])
  @@index([kind, createdAt])
  @@map("medical_stock_movements")
}

// ===========================================================================
// Quotations
// ===========================================================================

/// What the customer asked for.
///
/// Deliberately separate from the Quotation that answers it. The request is the
/// customer's words and belongs to them; the quotation is Nickimart's offer and
/// belongs to Nickimart. One request may be answered by several quotations
/// (split by supplier, or re-priced after a decline), and a quotation revised
/// three times must not rewrite what was originally asked for.
model QuotationRequest {
  id        String @id @default(cuid())
  /// Human reference: QR-2026-0147. What the customer quotes on the phone.
  reference String @unique

  customerId String?
  customer   MedicalCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  /// Captured on the form for a customer who has not signed in. A laboratory
  /// manager will not make an account before finding out whether you stock the
  /// thing, and a request lost at that gate is a sale lost at that gate.
  contactName  String @default("")
  contactEmail String @default("")
  contactPhone String @default("")
  institutionName String @default("")
  /// INDIVIDUAL | HOSPITAL | LABORATORY | ... — as the requester described it.
  institutionType String @default("")

  /// NEW | UNDER_REVIEW | AWAITING_SUPPLIER | DRAFTING | SENT |
  /// REVISION_REQUESTED | ACCEPTED | DECLINED | EXPIRED | CONVERTED | CANCELLED
  /// The set is in src/lib/medical/quotation-status.ts along with which
  /// transitions are legal and what each one's next action is.
  status String @default("NEW")

  assigneeId String?
  assignee   MedicalStaff? @relation("QuotationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Where it came from: STOREFRONT | PHONE | EMAIL | WALK_IN | REDISTRIBUTOR.
  source String @default("STOREFRONT")

  /// When they need it. Not a promise, an input to pricing.
  requiredBy DateTime?
  /// Delivery town or facility, as free text at request time.
  deliverTo  String @default("")
  /// Anything they want to say. Often the most useful field on the form.
  notes      String @default("")

  /// A request for something not in the catalogue. The customer describes it;
  /// procurement decides whether it can be sourced. Kept on the same model
  /// because a request is usually a mix — four catalogue items and one thing
  /// they could not find.
  specialRequest String @default("")

  /// Which redistributor, if any, sent this customer. Captured at request time
  /// because attribution must survive the weeks between request and sale.
  redistributorId String?
  redistributor   Redistributor? @relation(fields: [redistributorId], references: [id], onDelete: SetNull)

  /// The token a signed-out customer follows to read their own request without
  /// an account. Long, random, and the only thing that authorises that read.
  accessToken String @unique @default(cuid())

  submittedAt DateTime @default(now())
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      QuotationRequestItem[]
  quotations Quotation[]
  events     QuotationEvent[]

  @@index([status, submittedAt])
  @@index([customerId])
  @@index([organisationId])
  @@index([assigneeId, status])
  @@map("medical_quotation_requests")
}

model QuotationRequestItem {
  id        String @id @default(cuid())
  requestId String
  request   QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productId String?
  product   MedicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// What they asked for, in their words. Always written, even when a product
  /// matched — the catalogue name may change and the request must not.
  description String
  /// Their catalogue number, when they gave one.
  catalogueNumber String @default("")
  quantity    Int    @default(1)
  unit        String @default("unit")
  notes       String @default("")
  position    Int    @default(0)

  @@index([requestId, position])
  @@index([productId])
  @@map("medical_quotation_request_items")
}

/// A quotation: the commercial offer, at a version.
///
/// Issued versions are immutable. Editing an issued quotation creates the next
/// version of the same quotation, with its own line items, its own totals and
/// its own document. The customer holding version 2 and the console showing
/// version 3 must both be able to read exactly what they are looking at —
/// a quotation that silently changes under a customer who is still deciding is
/// the single worst failure this system could have.
model Quotation {
  id        String @id @default(cuid())
  /// QT-2026-0147. Shared by every version; the version number distinguishes
  /// them, so a customer and a salesperson quoting it on the phone agree.
  reference String
  version   Int    @default(1)

  requestId String?
  request   QuotationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  customerId String?
  customer   MedicalCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  /// QUOTATION | PROFORMA. The same editor, the same lines, the same totals,
  /// two documents with different standing. A proforma states agreed terms and
  /// is submitted to a finance office to release funds; it is not a receipt and
  /// not a tax invoice, and the template says so on its face.
  documentType String @default("QUOTATION")

  /// DRAFT | ISSUED | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED |
  /// SUPERSEDED | CONVERTED | CANCELLED
  status String @default("DRAFT")

  /// Frozen the moment the version is issued. Everything below this line is
  /// read-only from then on, enforced in src/lib/medical/quotations.ts.
  issuedAt   DateTime?
  sentAt     DateTime?
  firstViewedAt DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?
  declineReason String @default("")
  validUntil DateTime?

  issuedById String?
  issuedBy   MedicalStaff? @relation("QuotationIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  // --- The customer as the document prints them ----------------------------
  // Copied, not joined. An institution that renames itself next year must not
  // rename itself on a document issued this year.
  billToName    String @default("")
  billToContact String @default("")
  billToEmail   String @default("")
  billToPhone   String @default("")
  billToAddress String @default("")
  billToTaxId   String @default("")
  deliverToAddress String @default("")

  // --- Money. All server-computed; nothing here is ever posted by a browser --
  currency String @default("GHS")
  /// Sum of line totals after line discounts.
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  /// A discount on the whole document, after line discounts.
  /// PERCENT | AMOUNT | NONE
  discountKind   String  @default("NONE")
  discountValue  Decimal @default(0) @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(14, 2)
  handlingCharge Decimal @default(0) @db.Decimal(14, 2)
  otherCharge    Decimal @default(0) @db.Decimal(14, 2)
  otherChargeLabel String @default("")
  /// A tax line, off by default. No rate is assumed: the business states its
  /// VAT/NHIL position and an administrator sets it, or it stays at zero.
  taxLabel  String  @default("")
  taxRate   Decimal @default(0) @db.Decimal(7, 4)
  taxAmount Decimal @default(0) @db.Decimal(14, 2)

  /// The outright total, before any instalment uplift.
  totalOutright Decimal @default(0) @db.Decimal(14, 2)

  // --- Payment arrangement --------------------------------------------------
  /// OUTRIGHT | INSTALMENT
  paymentModel String @default("OUTRIGHT")
  paymentPlanId String?
  paymentPlan   PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  /// The plan's uplift, copied here at issue. The plan may be re-rated or
  /// withdrawn tomorrow; this quotation's arithmetic must not move.
  planUpliftRate   Decimal @default(0) @db.Decimal(7, 4)
  planUpliftAmount Decimal @default(0) @db.Decimal(14, 2)
  planMonths       Int     @default(0)
  planInstalments  Int     @default(0)
  planFrequency    String  @default("")
  depositRate      Decimal @default(0) @db.Decimal(7, 4)
  depositAmount    Decimal @default(0) @db.Decimal(14, 2)

  /// What is actually payable: totalOutright + planUpliftAmount.
  /// The figure printed large at the foot of the document.
  totalPayable Decimal @default(0) @db.Decimal(14, 2)

  /// "50% on order, balance before dispatch". Free text, template-defaulted.
  paymentTerms String @default("")
  /// Working days, as stated on this document.
  deliveryEstimate String @default("")
  /// Shown above the signature block.
  notes String @default("")
  /// The long text at the foot.
  termsAndConditions String @default("")

  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// The token the customer follows to read and accept this without an account.
  accessToken String @unique @default(cuid())
  /// The rendered PDF, once generated. Regenerated only if absent — a document
  /// that has been sent must not re-render differently later.
  pdfUrl String @default("")

  /// The version this one replaced, and the reason given for replacing it.
  supersedesId String?  @unique
  supersedes   Quotation? @relation("QuotationRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Quotation? @relation("QuotationRevision")
  revisionReason String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         QuotationItem[]
  schedule      InstalmentSchedule[]
  salesOrders   SalesOrder[]
  events        QuotationEvent[]

  @@unique([reference, version])
  @@index([status, issuedAt])
  @@index([customerId])
  @@index([organisationId])
  @@index([requestId])
  @@index([documentType, status])
  @@map("medical_quotations")
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId String?
  product   MedicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// What prints on the line. Editable, because the catalogue description is
  /// written for a storefront and a quotation often needs the manufacturer's
  /// exact wording, or a note about which pack size is being offered.
  description String
  catalogueNumber String @default("")
  /// A second line under the description, for specifications or a condition.
  detail String @default("")

  quantity  Int     @default(1)
  unit      String  @default("unit")
  unitPrice Decimal @db.Decimal(14, 2)

  /// PERCENT | AMOUNT | NONE
  discountKind   String  @default("NONE")
  discountValue  Decimal @default(0) @db.Decimal(14, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)

  /// quantity × unitPrice − discountAmount. Server-computed and stored, so a
  /// reissued document never re-derives a total that has drifted.
  lineTotal Decimal @default(0) @db.Decimal(14, 2)

  /// The internal cost at the moment of issue, for margin reporting. Never
  /// selected by any customer-facing query.
  unitCostAtIssue Decimal @default(0) @db.Decimal(14, 2)

  /// True for a line typed by hand rather than drawn from the catalogue —
  /// installation, training, a part sourced to order.
  isCustomLine Boolean @default(false)

  position Int @default(0)

  @@index([quotationId, position])
  @@index([productId])
  @@map("medical_quotation_items")
}

/// The audit trail of a request and its quotations: who did what, when.
///
/// Append-only. A quotation's commercial history is the thing a dispute turns
/// on, and "the price was changed" with no name and no timestamp against it is
/// not a record.
model QuotationEvent {
  id String @id @default(cuid())

  requestId String?
  request   QuotationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// SUBMITTED | ASSIGNED | STATUS_CHANGED | DRAFTED | ISSUED | SENT | VIEWED |
  /// REVISED | ACCEPTED | DECLINED | EXPIRED | CONVERTED | NOTE | REMINDER_SENT
  kind String

  /// One line for the timeline: "Status changed from New to Under review".
  summary String @default("")
  /// Structured before/after, as JSON, for anything worth diffing.
  detail  String @default("{}")

  /// STAFF | CUSTOMER | SYSTEM
  actorKind String @default("STAFF")
  actorId   String @default("")
  actorName String @default("")

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([quotationId, createdAt])
  @@map("medical_quotation_events")
}

// ===========================================================================
// Payment plans and instalments
// ===========================================================================

/// An instalment arrangement an administrator has configured.
///
/// Nothing about the ladder is compiled in. Durations, uplifts, deposits and
/// eligibility are all rows, because they are commercial decisions that will
/// change and must not need a deploy. The illustrative 3/6/12-month ladder in
/// the brief is seed data, not a constant.
model PaymentPlan {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  /// Shown to the customer under the name on a quotation.
  description String @default("")

  /// Months the balance is spread over. Zero for the outright plan.
  months Int @default(0)
  /// MONTHLY | FORTNIGHTLY | WEEKLY | CUSTOM
  frequency String @default("MONTHLY")
  /// How many payments after the deposit. Derived from months and frequency
  /// for the standard plans, set by hand for a custom one.
  instalmentCount Int @default(0)

  /// The price increase, as a rate: 0.0500 is +5%. Applied to the outright
  /// total after discounts and charges. Decimal, never a float — a 12-month
  /// plan on a GH₵84,500 analyser must come to the same figure every time it
  /// is computed.
  upliftRate Decimal @default(0) @db.Decimal(7, 4)

  /// The share of the adjusted total due before anything is dispatched.
  depositRate Decimal @default(0) @db.Decimal(7, 4)
  /// A floor under the deposit in GH₵, when a rate alone is not enough.
  minimumDeposit Decimal @default(0) @db.Decimal(14, 2)

  /// Eligibility. Below this order value the plan is not offered.
  minimumOrderValue Decimal @default(0) @db.Decimal(14, 2)
  /// Whether an individual may take it, or only an approved institution.
  institutionsOnly  Boolean @default(true)
  requiresCreditApproval Boolean @default(true)

  /// Days after a due date before a payment is late.
  graceDays Int @default(0)
  /// A charge on a late instalment, as a rate of the instalment. Zero until the
  /// business has cleared what it may charge; see docs/medical/REGULATORY.md.
  lateFeeRate Decimal @default(0) @db.Decimal(7, 4)
  lateFeePolicy String @default("")

  /// A one-off administrative charge, where one is permitted.
  adminFee Decimal @default(0) @db.Decimal(14, 2)

  /// The terms line this plan writes onto a quotation by default.
  termsText String @default("")

  isActive Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@index([isActive, position])
  @@map("medical_payment_plans")
}

/// One dated instalment on a quotation or an order.
///
/// Generated when a plan is applied, and copied forward unchanged when the
/// quotation converts to an order. The schedule the customer agreed to is the
/// schedule they owe, whatever the plan's settings do afterwards.
model InstalmentSchedule {
  id String @id @default(cuid())

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  /// 0 is the deposit; 1..n are the instalments.
  sequence Int @default(0)
  /// DEPOSIT | INSTALMENT | FINAL | ADMIN_FEE | LATE_FEE
  kind     String @default("INSTALMENT")

  dueDate DateTime
  amount  Decimal @db.Decimal(14, 2)
  /// Allocated from payments as they arrive, oldest due first.
  amountPaid Decimal @default(0) @db.Decimal(14, 2)
  /// amount − amountPaid, written on each allocation so a receivables query is
  /// one indexed scan rather than a join and a sum per row.
  balance Decimal @default(0) @db.Decimal(14, 2)

  /// PENDING | PARTIAL | PAID | OVERDUE | WAIVED | CANCELLED
  status String @default("PENDING")

  paidAt DateTime?
  /// Set by the overdue sweep, so "how late" is a stored fact rather than a
  /// recomputation against a moving clock.
  markedOverdueAt DateTime?
  waivedReason String @default("")

  note String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([salesOrderId, sequence])
  @@index([quotationId, sequence])
  @@index([status, dueDate])
  @@map("medical_instalment_schedules")
}

// ===========================================================================
// Orders, payments, fulfilment
// ===========================================================================

/// A sale. From the storefront, from an accepted quotation, or from the POS.
///
/// Payment state and fulfilment state are separate columns on purpose: an order
/// can be fully paid and not yet picked, or dispatched on approved terms and
/// not yet paid. Collapsing them into one status is how a warehouse ends up
/// shipping against an unpaid order.
model SalesOrder {
  id        String @id @default(cuid())
  reference String @unique

  /// STOREFRONT | QUOTATION | POS | PHONE
  channel String @default("STOREFRONT")

  customerId String?
  customer   MedicalCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  /// A walk-in at the counter who is not in the system.
  walkInName  String @default("")
  walkInPhone String @default("")

  /// The quotation this came from, when it came from one. Converting copies
  /// lines, prices and schedule across rather than re-entering them, and this
  /// is what proves the order's prices were the agreed ones.
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  /// PENDING | CONFIRMED | PROCESSING | PARTIALLY_DISPATCHED | DISPATCHED |
  /// DELIVERED | COMPLETED | CANCELLED | REFUNDED
  fulfilmentStatus String @default("PENDING")
  /// UNPAID | DEPOSIT_PAID | PARTIALLY_PAID | PAID | REFUNDED | WRITTEN_OFF
  paymentStatus    String @default("UNPAID")

  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String    @default("")

  // --- Money. Copied from the quotation on conversion, computed otherwise ----
  currency       String  @default("GHS")
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(14, 2)
  handlingCharge Decimal @default(0) @db.Decimal(14, 2)
  otherCharge    Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalOutright  Decimal @default(0) @db.Decimal(14, 2)

  paymentModel     String  @default("OUTRIGHT")
  paymentPlanId    String?
  paymentPlan      PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  planUpliftAmount Decimal @default(0) @db.Decimal(14, 2)

  /// What is owed in total, and what has been collected against it. Collected
  /// is written by payment allocation and nowhere else.
  totalPayable   Decimal @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal @default(0) @db.Decimal(14, 2)
  amountRefunded Decimal @default(0) @db.Decimal(14, 2)
  /// totalPayable − amountPaid + amountRefunded. Stored so the receivables
  /// report does not recompute it per row.
  balanceDue     Decimal @default(0) @db.Decimal(14, 2)

  /// Cost of goods on this order, summed from the lines at dispatch. The basis
  /// for gross profit. Never selected by a customer-facing query.
  costOfGoods Decimal @default(0) @db.Decimal(14, 2)

  deliveryAddressId String?
  deliveryAddress   CustomerAddress? @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  billingAddressId  String?
  billingAddress    CustomerAddress? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  /// Frozen copy of the delivery address as printed on the delivery note.
  deliverySnapshot  String @default("")

  /// SELF_COLLECTION | COURIER | SUPPLIER_DIRECT
  deliveryMethod String @default("COURIER")
  trackingNote   String @default("")

  /// A discount code applied at checkout.
  promotionCode String @default("")

  /// Who sold it, when it was sold across a counter.
  posOperatorId String?
  posOperator   MedicalStaff? @relation("PosOperator", fields: [posOperatorId], references: [id], onDelete: SetNull)

  redistributorId String?
  redistributor   Redistributor? @relation(fields: [redistributorId], references: [id], onDelete: SetNull)

  customerNote String @default("")
  internalNote String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       SalesOrderItem[]
  payments    Payment[]
  refunds     Refund[]
  schedule    InstalmentSchedule[]
  commissions RedistributorCommission[]

  @@index([fulfilmentStatus, placedAt])
  @@index([paymentStatus, placedAt])
  @@index([customerId])
  @@index([organisationId])
  @@index([quotationId])
  @@index([redistributorId])
  @@map("medical_sales_orders")
}

model SalesOrderItem {
  id           String @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  productId String?
  product   MedicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Frozen at the moment of sale. A product renamed or repriced next month
  /// must not rewrite this order.
  description     String
  catalogueNumber String @default("")
  sku             String @default("")

  quantity  Int     @default(1)
  unit      String  @default("unit")
  unitPrice Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  lineTotal Decimal @default(0) @db.Decimal(14, 2)

  /// Unit cost at sale, for margin. Private.
  unitCost Decimal @default(0) @db.Decimal(14, 2)

  quantityReserved   Int @default(0)
  quantityDispatched Int @default(0)
  quantityReturned   Int @default(0)

  /// Which batches this line was filled from, as [{ batchId, quantity }].
  /// Needed to trace a recall to the customers who received that batch.
  batchAllocation String @default("[]")

  position Int @default(0)

  @@index([salesOrderId, position])
  @@index([productId])
  @@map("medical_sales_order_items")
}

/// Money in.
///
/// Idempotent on providerReference: Paystack will deliver the same webhook more
/// than once, and a second insert for one charge would both double the
/// collections figure and pay a redistributor twice.
model Payment {
  id        String @id @default(cuid())
  reference String @unique

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  /// PAYSTACK | BANK | MOMO | CASH | CARD | CHEQUE | OTHER
  method String @default("PAYSTACK")
  /// PENDING | SUCCESSFUL | FAILED | REVERSED
  status String @default("PENDING")

  currency String  @default("GHS")
  amount   Decimal @db.Decimal(14, 2)

  /// The gateway's own reference. Unique where present — the idempotency key
  /// for webhook replay.
  providerReference String? @unique
  /// The verification payload, kept for disputes.
  providerPayload   String  @default("{}")

  paidAt   DateTime?
  /// Who keyed it in, for a payment taken at the counter or recorded by hand.
  recordedById String @default("")
  note        String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([salesOrderId, status])
  @@index([status, paidAt])
  @@map("medical_payments")
}

/// Which instalment a payment settled.
///
/// A payment is not always one instalment: a customer pays a round GH₵5,000
/// against a deposit of GH₵4,200 and the balance runs into the first
/// instalment. Without this table "what is still owed" is a guess.
model PaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   InstalmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, scheduleId])
  @@index([scheduleId])
  @@map("medical_payment_allocations")
}

/// Money back out.
model Refund {
  id        String @id @default(cuid())
  reference String @unique

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  /// PENDING | APPROVED | PROCESSED | REJECTED
  status String @default("PENDING")
  /// RETURN | CANCELLATION | OVERPAYMENT | GOODWILL | ERROR
  reasonKind String @default("RETURN")
  reason     String @default("")

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("GHS")
  method   String  @default("PAYSTACK")
  providerReference String?

  /// Whether the goods came back, and therefore whether stock was restored.
  goodsReturned Boolean @default(false)
  /// Whether the returned goods were resaleable. Damaged returns post to a
  /// damage movement rather than back into available stock.
  restocked     Boolean @default(false)

  requestedById String @default("")
  approvedById  String @default("")
  approvedAt    DateTime?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesOrderId, status])
  @@map("medical_refunds")
}

// ===========================================================================
// Finance
// ===========================================================================

/// The ledger. Every financial event, once.
///
/// Why this exists: without it, "revenue" gets counted when a quotation is
/// accepted, again when the invoice is raised, and again when the money lands,
/// and every report disagrees with every other one. One row per event, with the
/// thing that caused it named, and reports are sums over this table rather than
/// over whatever each screen happened to compute.
///
/// Append-only. A mistake is corrected by a reversing entry that points back at
/// the entry it reverses, never by an update or a delete — the correction and
/// the thing it corrects both stay readable.
model FinancialTransaction {
  id        String @id @default(cuid())
  reference String @unique

  /// SALE_REVENUE | CASH_RECEIPT | REFUND | COGS | PURCHASE | SUPPLIER_PAYMENT |
  /// EXPENSE | COMMISSION_ACCRUAL | COMMISSION_PAYOUT | STOCK_WRITE_OFF |
  /// DISCOUNT | ADJUSTMENT
  kind String

  /// DEBIT | CREDIT, from the business's point of view. Kept explicit rather
  /// than inferred from the sign, so a reversal reads as a reversal.
  direction String @default("CREDIT")

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("GHS")

  /// When it happened in the business, which is not when the row was written.
  /// A payment recorded on Monday for a Friday transfer belongs to Friday.
  occurredAt DateTime @default(now())

  /// What caused it: SALES_ORDER | PAYMENT | REFUND | PURCHASE_ORDER |
  /// SUPPLIER_INVOICE | SUPPLIER_PAYMENT | EXPENSE | COMMISSION | STOCK_MOVEMENT
  sourceType String
  sourceId   String

  /// The entry this one reverses, when it is a correction.
  reversesId String? @unique
  reverses   FinancialTransaction? @relation("Reversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy FinancialTransaction? @relation("Reversal")

  description String @default("")
  recordedById String @default("")

  createdAt DateTime @default(now())

  @@index([kind, occurredAt])
  @@index([sourceType, sourceId])
  @@index([occurredAt])
  @@map("medical_financial_transactions")
}

model ExpenseCategory {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  isActive Boolean @default(true)
  position Int     @default(0)

  expenses Expense[]

  @@map("medical_expense_categories")
}

model Expense {
  id        String @id @default(cuid())
  reference String @unique

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description String
  amount      Decimal @db.Decimal(14, 2)
  currency    String  @default("GHS")

  incurredAt DateTime @default(now())
  /// BANK | MOMO | CASH | CARD | OTHER
  method     String   @default("CASH")
  payee      String   @default("")
  receiptUrl String   @default("")

  /// DRAFT | APPROVED | PAID | REJECTED
  status String @default("PAID")

  recordedById String @default("")
  approvedById String @default("")
  note         String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, incurredAt])
  @@index([status, incurredAt])
  @@map("medical_expenses")
}

// ===========================================================================
// Redistributors
// ===========================================================================

/// A redistributor: the medical business's name for what retail calls an
/// affiliate. Same shape, same rules, different word and a different palette —
/// the attribution, commission, ledger and team logic is ported from
/// src/lib/affiliate-*.ts rather than reinvented.
model Redistributor {
  id     String @id @default(cuid())
  /// Retail User.id.
  userId String @unique
  /// The slug in their referral link: /medicals?r=ama-kwarteng.
  code   String @unique

  name  String @default("")
  email String @default("")
  phone String @default("")

  /// PENDING | APPROVED | SUSPENDED | REJECTED | CLOSED
  status     String    @default("PENDING")
  appliedAt  DateTime  @default(now())
  approvedAt DateTime?
  approvedById String  @default("")
  statusNote String    @default("")

  /// Their own storefront page: a heading, a blurb, a logo. One catalogue,
  /// their presentation of it — not a separate shop.
  storefrontTitle String @default("")
  storefrontBio   String @default("")
  storefrontLogo  String @default("")
  /// Their saved flyer design, as JSON. Same shape as the retail flyer studio.
  flyerDesign     String @default("{}")

  /// Their commission rate, as a rate. Null falls back to the category rate and
  /// then to the programme default in MedicalSetting.
  commissionRate Decimal? @db.Decimal(7, 4)

  /// Who recruited them, for the team tree.
  parentId String?
  parent   Redistributor?  @relation("RedistributorTeam", fields: [parentId], references: [id], onDelete: SetNull)
  children Redistributor[] @relation("RedistributorTeam")

  /// Running totals, maintained by the ledger rather than recomputed per view.
  totalEarned    Decimal @default(0) @db.Decimal(14, 2)
  totalPaidOut   Decimal @default(0) @db.Decimal(14, 2)
  availableBalance Decimal @default(0) @db.Decimal(14, 2)
  /// Earned but not yet eligible — the order is not paid, or the return window
  /// is open.
  pendingBalance Decimal @default(0) @db.Decimal(14, 2)

  payoutMethod  String @default("")
  payoutDetails String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals         RedistributorReferral[]
  commissions       RedistributorCommission[]
  ledger            RedistributorLedgerEntry[]
  payouts           RedistributorPayout[]
  salesOrders       SalesOrder[]
  quotationRequests QuotationRequest[]

  @@index([status])
  @@index([parentId])
  @@map("medical_redistributors")
}

/// A customer attributed to a redistributor.
///
/// Attribution is captured when the referral link is followed and has to
/// survive the gap between that click and a sale that may be a quotation and
/// six weeks away. Recorded here at first touch; the sale reads it back.
model RedistributorReferral {
  id              String @id @default(cuid())
  redistributorId String
  redistributor   Redistributor @relation(fields: [redistributorId], references: [id], onDelete: Cascade)

  /// The medical customer, once they have an account.
  customerId String?
  /// Before that: the anonymous visitor id from the referral cookie.
  visitorKey String @default("")

  /// The window within which a sale still counts as theirs.
  firstSeenAt DateTime @default(now())
  expiresAt   DateTime?

  /// What they landed on.
  landingPath String @default("")

  createdAt DateTime @default(now())

  @@unique([redistributorId, customerId])
  @@index([customerId])
  @@index([visitorKey])
  @@map("medical_redistributor_referrals")
}

/// Commission earned on one order line.
///
/// Unique on (orderId, productId, redistributorId): the same line cannot earn
/// twice however many times a webhook or a status sweep runs over it.
model RedistributorCommission {
  id              String @id @default(cuid())
  redistributorId String
  redistributor   Redistributor @relation(fields: [redistributorId], references: [id], onDelete: Cascade)

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  product      MedicalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// PENDING | ELIGIBLE | PAID | CANCELLED | REVERSED
  /// Pending until the order is paid and past its return window; cancelled when
  /// the order is cancelled; reversed when it is refunded after being paid out.
  status String @default("PENDING")

  /// What it was computed on and at what rate — stored, so a later rate change
  /// cannot rewrite what was earned.
  baseAmount Decimal @db.Decimal(14, 2)
  rate       Decimal @db.Decimal(7, 4)
  amount     Decimal @db.Decimal(14, 2)

  /// TEAM commission earned on a recruit's sale, rather than one's own.
  isTeamCommission Boolean @default(false)
  /// The recruit whose sale earned it.
  sourceRedistributorId String?

  eligibleAt DateTime?
  paidAt     DateTime?
  cancelReason String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesOrderId, productId, redistributorId, isTeamCommission])
  @@index([redistributorId, status])
  @@index([status, eligibleAt])
  @@map("medical_redistributor_commissions")
}

/// Append-only running balance. Every credit and debit against a
/// redistributor's account, with the balance after it.
model RedistributorLedgerEntry {
  id              String @id @default(cuid())
  redistributorId String
  redistributor   Redistributor @relation(fields: [redistributorId], references: [id], onDelete: Cascade)

  /// COMMISSION | TEAM_COMMISSION | PAYOUT | REVERSAL | ADJUSTMENT | BONUS
  kind String

  /// Signed: a credit is positive, a payout negative.
  amount       Decimal @db.Decimal(14, 2)
  balanceAfter Decimal @db.Decimal(14, 2)

  sourceType String @default("")
  sourceId   String @default("")
  note       String @default("")

  createdAt DateTime @default(now())

  @@index([redistributorId, createdAt])
  @@map("medical_redistributor_ledger")
}

model RedistributorPayout {
  id              String @id @default(cuid())
  reference       String @unique
  redistributorId String
  redistributor   Redistributor @relation(fields: [redistributorId], references: [id], onDelete: Cascade)

  /// REQUESTED | APPROVED | PAID | REJECTED | CANCELLED
  status String @default("REQUESTED")

  amount Decimal @db.Decimal(14, 2)
  method String  @default("")
  details String @default("")

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  approvedById String   @default("")
  note        String    @default("")
  providerReference String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([redistributorId, status])
  @@index([status, requestedAt])
  @@map("medical_redistributor_payouts")
}

// ===========================================================================
// Content, documents, settings
// ===========================================================================

/// A saved look for a quotation or proforma: logo, colours, type, layout.
///
/// The same idea as the affiliate flyer studio, applied to a commercial
/// document. A business sends the same document hundreds of times and will want
/// to change the logo once, not on every one.
model DocumentTemplate {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// QUOTATION | PROFORMA | INVOICE | RECEIPT | DELIVERY_NOTE
  documentType String @default("QUOTATION")

  /// The whole design, as JSON: colours, fonts, logo, header and footer blocks,
  /// which columns the product table shows and in what order, margins. JSON
  /// because it is read and written as one object by the designer and never
  /// queried by its parts — the same reason the flyer design is JSON.
  design String @default("{}")

  /// Defaults this template writes onto a new document.
  defaultPaymentTerms String @default("")
  defaultNotes        String @default("")
  defaultTerms        String @default("")
  defaultValidityDays Int    @default(30)

  /// "QT-{YYYY}-{0000}". Expanded by src/lib/medical/numbering.ts.
  numberFormat String @default("QT-{YYYY}-{0000}")
  dateFormat   String @default("d MMM yyyy")

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]

  @@index([documentType, isActive])
  @@map("medical_document_templates")
}

/// The running counter behind each document reference.
///
/// A row per series per year, incremented inside the same transaction that
/// creates the document. Deriving the next number from max(reference) races:
/// two quotations drafted in the same second would both read the same maximum
/// and both be numbered QT-2026-0148.
model DocumentCounter {
  id     String @id @default(cuid())
  /// QUOTATION | PROFORMA | REQUEST | ORDER | PAYMENT | REFUND | PO | GRN |
  /// SUPPLIER_INVOICE | SUPPLIER_PAYMENT | EXPENSE | PAYOUT | TRANSACTION
  series String
  year   Int
  value  Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([series, year])
  @@map("medical_document_counters")
}

/// Homepage content an administrator controls: hero, banners, promotional
/// strips, the rails and what goes in them.
model HomepageBlock {
  id   String @id @default(cuid())
  /// HERO | BANNER | PRODUCT_RAIL | CATEGORY_GRID | PROMO | SUPPORT | RICH_TEXT
  kind String
  /// Where it sits, top to bottom.
  position Int @default(0)

  title    String @default("")
  subtitle String @default("")
  body     String @default("")

  image     String @default("")
  imageAlt  String @default("")
  ctaLabel  String @default("")
  ctaHref   String @default("")
  secondaryCtaLabel String @default("")
  secondaryCtaHref  String @default("")

  /// For a product rail: FEATURED | NEW | CATEGORY | MANUAL, and what it points
  /// at. Manual rails list product ids in `config`.
  source   String @default("")
  config   String @default("{}")

  isActive Boolean @default(true)
  /// Scheduling, for a promotion that runs to a date.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("medical_homepage_blocks")
}

/// A discount code.
model Promotion {
  id   String @id @default(cuid())
  code String @unique
  name String @default("")

  /// PERCENT | AMOUNT | FREE_DELIVERY
  kind  String  @default("PERCENT")
  value Decimal @default(0) @db.Decimal(14, 4)

  minimumOrderValue Decimal @default(0) @db.Decimal(14, 2)
  maximumDiscount   Decimal @default(0) @db.Decimal(14, 2)

  /// Zero means unlimited.
  usageLimit      Int @default(0)
  usageCount      Int @default(0)
  perCustomerLimit Int @default(0)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean  @default(true)

  /// Restrict to categories or products, as id arrays. Empty means everything.
  categoryIds String @default("[]")
  productIds  String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, endsAt])
  @@map("medical_promotions")
}

model SupportRequest {
  id        String @id @default(cuid())
  reference String @unique

  customerId String?
  customer   MedicalCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name    String @default("")
  email   String @default("")
  phone   String @default("")
  subject String
  message String

  /// GENERAL | ORDER | QUOTATION | PRODUCT | DELIVERY | PAYMENT | COMPLAINT
  topic  String @default("GENERAL")
  /// OPEN | IN_PROGRESS | WAITING_CUSTOMER | RESOLVED | CLOSED
  status String @default("OPEN")

  /// The order or quotation it is about, when it is about one.
  relatedType String @default("")
  relatedId   String @default("")

  assigneeId String?
  resolution String @default("")
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@map("medical_support_requests")
}

/// A message to a person, in the console or by email.
model MedicalNotification {
  id String @id @default(cuid())

  /// STAFF | CUSTOMER | REDISTRIBUTOR
  audience    String @default("STAFF")
  /// The MedicalStaff / MedicalCustomer / Redistributor id. Blank means the
  /// whole audience.
  recipientId String @default("")

  /// QUOTATION_REQUEST | QUOTATION_SENT | QUOTATION_ACCEPTED | ORDER_PLACED |
  /// PAYMENT_RECEIVED | INSTALMENT_DUE | INSTALMENT_OVERDUE | LOW_STOCK |
  /// EXPIRING_BATCH | PO_OVERDUE | PAYOUT_REQUESTED | SUPPORT_REQUEST
  kind String

  title String
  body  String @default("")
  href  String @default("")

  readAt     DateTime?
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([audience, recipientId, readAt])
  @@index([kind, createdAt])
  @@map("medical_notifications")
}

/// Who did what, across the console.
///
/// Separate from QuotationEvent, which is the commercial history of one
/// document and is read by the people working it. This is the security record:
/// every write to a price, a role, a payment or a stock figure, kept whether or
/// not anybody ever looks at it.
model MedicalAuditLog {
  id String @id @default(cuid())

  staffId String?
  staff   MedicalStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  /// Kept as plain text too, so the record survives the staff row being removed.
  actorName String @default("")
  actorId   String @default("")

  /// CREATE | UPDATE | DELETE | ISSUE | SEND | ACCEPT | CANCEL | APPROVE |
  /// REJECT | LOGIN | EXPORT | ADJUST
  action String
  /// The model and row it happened to.
  entity   String
  entityId String @default("")

  summary String @default("")
  /// { before, after } for the fields that changed.
  changes String @default("{}")

  ipAddress String @default("")
  userAgent String @default("")

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([staffId, createdAt])
  @@index([action, createdAt])
  @@map("medical_audit_logs")
}

/// Key/value settings for the medical business. One row per setting so a change
/// is one small write and the audit log shows exactly what moved.
model MedicalSetting {
  key       String   @id
  value     String   @default("")
  /// string | number | boolean | json — how src/lib/medical/settings.ts parses
  /// the value.
  valueType String   @default("string")
  /// Which settings screen it belongs on.
  group     String   @default("general")
  label     String   @default("")
  helpText  String   @default("")
  updatedAt DateTime @updatedAt
  updatedById String @default("")

  @@index([group])
  @@map("medical_settings")
}
