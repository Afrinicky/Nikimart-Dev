// Nickimart — Data Bundles database.
//
// The bundle business runs on its own Postgres database, separate from the
// retail mall. Everything that belongs to it lives here: the price ladder,
// bundle and AFA orders, the whole sub-agent platform (accounts, prices,
// ledger, withdrawals, applications, referrals) and the settings its admin
// console reads. The mall's database keeps users, products and shipping and
// knows nothing about any of it.
//
// Why separate: the two businesses fail, grow and get restored independently.
// A bundle price edit should never contend with a Black Friday checkout, and a
// restore of one side should never roll the other side back.
//
// The one thing that crosses the line is identity. An agent signs in with a
// Nickimart account, so `DataAgent.userId` holds a `User.id` from the mall
// database — as a plain, indexed column, not a foreign key, because Postgres
// cannot enforce a reference into another database. Code that needs the person
// behind an agent reads the agent here and then looks the user up there; the
// helpers in src/lib/data-bundles/user-link.ts do exactly that, in one round
// trip for a whole page of rows.
//
// DATA_DATABASE_URL points at that database. When it isn't set the client
// falls back to DATABASE_URL, so an environment that hasn't been split yet
// keeps working exactly as before (see src/lib/data-db.ts).

generator client {
  provider = "prisma-client-js"
  // Its own output directory: two clients generated to the same default path
  // would overwrite each other, and the second `prisma generate` would leave
  // the app importing the wrong schema's types.
  output   = "../../node_modules/.prisma/data-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATA_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Bundles and orders — fulfilled through the Justice Datashop agent API.
// ---------------------------------------------------------------------------

// One sellable bundle: a size on a network, at the price NikiMart charges.
// `costPrice` is what the upstream agent account is billed, so the admin can
// see the margin on every row. Prices are GH₵ (the provider quotes pesewas).
model DataBundle {
  id         String   @id @default(cuid())
  // MTN | TELECEL | AIRTELTIGO_ISHARE | AIRTELTIGO_BIGTIME (see lib/data-bundles/networks.ts).
  network    String
  // Volume in GB, as sent to the provider's `size` field.
  sizeGb     Float
  // Selling price shown on the storefront (GH₵).
  price      Float
  // Upstream cost (GH₵). 0 when unknown — margin is then just not shown.
  costPrice  Float    @default(0)
  // What NikiMart charges its own sub-agents for this bundle (GH₵). It is the
  // agent's cost basis: their commission on a storefront sale is whatever they
  // charge above this. 0 means "not resold to agents", and the bundle is then
  // hidden from agent storefronts. Set it in Admin → Data → Bundle prices.
  agentPrice Float    @default(0)
  // What the *recruiter* of the selling agent earns when this bundle is sold
  // by one of their direct recruits (GH₵ per sale). It comes out of Nickimart's
  // margin, not out of the selling agent's commission, so it is set per bundle
  // here in Admin → Data bundles → Bundle prices rather than derived from a
  // percentage somewhere else. 0 means "use the programme default" (see the
  // referralTeamCommission settings); set the default to 0 as well to pay
  // nothing on this bundle.
  teamCommission Float @default(0)
  // Optional marketing line, e.g. "No expiry · instant delivery".
  validity   String   @default("No expiry")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([network, sizeGb])
  @@index([network, isActive])
}

// A single bundle purchase. Guests can buy (no account needed), so `userId` is
// optional and the buyer is identified by phone.
model DataOrder {
  id        String @id @default(cuid())
  // Doubles as the Paystack transaction reference (ND-…), so it must be unique.
  reference String @unique

  network        String
  sizeGb         Float
  // Price charged and upstream cost, snapshotted at purchase time so later
  // price edits never rewrite past orders or the profit report.
  price          Float
  costPrice      Float   @default(0)
  // Local Ghana number the data is credited to (0XXXXXXXXX).
  recipientPhone String
  // Who bought it — for the receipt SMS and order lookup.
  buyerPhone     String
  buyerEmail     String?
  buyerName      String?

  // pending | paid | queued | processing | completed | failed | refunded
  status        String    @default("pending")
  // unpaid | paid — payment is separate from delivery, so a paid-but-undelivered
  // order is visible to the admin as exactly that.
  paymentStatus String    @default("unpaid")
  paidAt        DateTime?

  // Upstream (Justice Datashop) references, filled in once dispatched.
  providerOrderId String?
  providerCode    String?
  providerStatus  String?
  providerMessage String?
  dispatchedAt    DateTime?
  completedAt     DateTime?

  // --- Sub-agent attribution ------------------------------------------------
  // Set when the sale came through an agent: either their public storefront or
  // the Data Topup screen inside their own dashboard.
  agentId          String?
  agent            DataAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // WEB | STOREFRONT | AGENT — where the order was placed. WEB is NikiMart's
  // own /data-bundles storefront.
  source           String     @default("WEB")
  // The agent price in force when the order was placed (the agent's cost), and
  // the commission they earn on it. Both are snapshotted so a later price edit
  // never rewrites what was owed.
  agentCost        Float      @default(0)
  agentCommission  Float      @default(0)
  // pending | earned | void. Commission is only credited once the bundle has
  // actually been delivered, so a failed order never pays out.
  commissionStatus String     @default("pending")
  commissionPaidAt DateTime?

  // --- Team-sales commission (the selling agent's recruiter) ----------------
  // The agent who recruited the selling agent, and what they earn on this sale.
  // Both are snapshotted at purchase, exactly like the selling agent's own
  // numbers, so changing the rate or the referral later never rewrites what was
  // owed. Only the direct recruiter earns: the programme is two levels deep for
  // *recruitment* rewards and one level deep for sales.
  teamAgentId          String?
  teamAgent            DataAgent? @relation("TeamUpline", fields: [teamAgentId], references: [id], onDelete: SetNull)
  teamCommission       Float      @default(0)
  // pending | earned | void — same lifecycle as the selling agent's.
  teamCommissionStatus String     @default("pending")
  teamCommissionPaidAt DateTime?

  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerPhone])
  @@index([recipientPhone])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([teamAgentId, createdAt])
}

// An AFA (agent SIM) registration sold through the storefront and submitted to
// the provider once paid.
model AfaRegistration {
  id        String @id @default(cuid())
  reference String @unique

  fullName    String
  phoneNumber String
  idNumber    String
  dateOfBirth String
  town        String
  occupation  String

  price         Float
  // pending | paid | processing | completed | failed
  status        String    @default("pending")
  paymentStatus String    @default("unpaid")
  paidAt        DateTime?

  providerId      String?
  providerStatus  String?
  providerMessage String?
  dispatchedAt    DateTime?
  completedAt     DateTime?

  // Sub-agent attribution, exactly as on DataOrder — including the selling
  // agent's recruiter, when the referral programme counts AFA as a qualifying
  // sale (Admin → Referrals decides; it is off by default).
  agentId          String?
  agent            DataAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  source           String     @default("WEB")
  agentCost        Float      @default(0)
  agentCommission  Float      @default(0)
  commissionStatus String     @default("pending")
  commissionPaidAt DateTime?

  teamAgentId          String?
  teamAgent            DataAgent? @relation("AfaTeamUpline", fields: [teamAgentId], references: [id], onDelete: SetNull)
  teamCommission       Float      @default(0)
  teamCommissionStatus String     @default("pending")
  teamCommissionPaidAt DateTime?

  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([teamAgentId, createdAt])
}

// ---------------------------------------------------------------------------
// Sub-agent platform — NikiMart resells to its own agents exactly as Justice
// Datashop resells to NikiMart. An agent opens a storefront, sets their own
// retail prices on top of the agent price NikiMart charges them, and earns the
// difference as commission once each order is delivered.
//
// Agents never stock a wallet: every sale is paid by the customer through
// Paystack at the moment of purchase. The only money that moves into an agent
// account is commission, and the only money out is a MoMo withdrawal.
// ---------------------------------------------------------------------------

model DataAgent {
  id     String @id @default(cuid())
  /**
   * The `User.id` of the Nickimart account this agent signs in with. It lives
   * in the retail database, so this is a plain indexed column rather than a
   * foreign key — Postgres cannot reference across databases. Resolve it with
   * the helpers in lib/data-bundles/user-link.ts.
   */
  userId String @unique

  // Human-friendly agent code, e.g. "NKM4821" — shown on the dashboard and
  // quoted in support.
  code String @unique

  // The storefront. `slug` is the public path segment: /store/<slug>.
  slug         String  @unique
  storeName    String
  // Short line under the store name on the public storefront.
  storeTagline String  @default("")
  storeAbout   String  @default("")
  // "open" hides nothing; "closed" shows a closed notice instead of the grid.
  storeOpen    Boolean @default(true)

  supportPhone    String @default("")
  supportWhatsapp String @default("")
  whatsappGroup   String @default("")

  // The agent's own AFA registration price. 0 means "use NikiMart's price"
  // (and earn nothing on it); afaEnabled hides AFA from their storefront.
  afaPrice   Float   @default(0)
  afaEnabled Boolean @default(true)

  // active | suspended. A suspended agent keeps their balance and history but
  // their storefront stops selling and they stop earning.
  status String @default("active")

  // Running balance in GH₵. Opens negative — the storefront setup fee is
  // charged the moment the store is created — and climbs back through zero as
  // commissions land. Only a positive balance can be withdrawn.
  balance  Float @default(0)
  // What the store cost to open, kept for the ledger narration and for the
  // "still to clear" line on the wallet.
  setupFee Float @default(0)

  // --- Registration fee -----------------------------------------------------
  // How the registration fee is being settled, chosen by the applicant when
  // they apply:
  //   BALANCE — debited on approval; the account opens negative and clears
  //             itself out of commission (the original behaviour).
  //   UPFRONT — the agent pays it through Paystack before the store opens.
  //   WAIVED  — an admin set the fee to zero for this agent.
  // This drives one thing beyond narration: referral rewards are released only
  // once the fee has actually been *paid*, and a waived fee never pays anyone.
  setupFeeMethod String    @default("BALANCE")
  // When the fee was settled in full — the moment referral rewards become
  // payable. Null while it is still outstanding, and null forever if waived.
  setupFeePaidAt DateTime?
  // Paystack reference for an upfront payment, so it can be verified and never
  // credited twice.
  setupFeeReference String?
  /**
   * How the fee was actually settled — PAYMENT, COMMISSION, ADJUSTMENT or
   * WAIVED. It exists because only the first two are somebody paying: a
   * balance an admin credited to clear the fee is Nickimart writing it off,
   * and writing a fee off must not pay the recruiter a reward for a
   * registration nobody paid for. Null on rows settled before this was
   * recorded, which are read as genuinely paid.
   */
  setupFeeSettledBy String?

  // --- What the registration fee was made of --------------------------------
  // `setupFee` above is what this agent actually owes. These four say how that
  // number came about, because a waiver is somebody else's money: the fee at
  // full price, the percentage taken off it because a referrer's recruits get
  // a discount, the cedis that discount was worth, and the share of what the
  // agent *does* pay that goes to their recruiter. Recorded on the row rather
  // than recomputed, so a settings change tomorrow never rewrites what this
  // registration was.
  setupFeeGross         Float @default(0)
  setupFeeWaiverPercent Float @default(0)
  setupFeeWaived        Float @default(0)
  setupFeeReferrerShare Float @default(0)

  // --- Referral -------------------------------------------------------------
  /**
   * The registration waiver *this agent's own recruits* receive, as a
   * percentage of the fee. Null means "use the programme default"; 100 is a
   * full waiver, and whether that still pays a joining reward is the admin's
   * call (see the referralFullWaiverPaysReward setting). Set per agent, so a
   * recruiter who has earned it can bring people in cheaper than the rest.
   */
  referralWaiverPercent Float?
  /**
   * Of whatever this agent's own recruits *do* pay towards their registration,
   * the percentage credited back to this agent. Null means "use the programme
   * default"; an explicit 0 means this agent is never credited a share,
   * whatever the default becomes. The waiver above decides what a recruit is
   * charged; this decides who keeps it.
   */
  referralSharePercent Float?
  /**
   * How the people *this* agent recruits may settle their own registration
   * fee: UPFRONT, COMMISSION or BOTH. Null means "follow the programme", which
   * is what every agent does unless an admin says otherwise — and the
   * programme setting decides whether a per-agent value is consulted at all.
   * This is the exception mechanism behind "everyone pays up front, except
   * the people these three bring in".
   */
  recruitPaymentMode String?
  /**
   * The agent who recruited this one — their direct (level 1) upline. Set once,
   * when the account is created from an application that quoted a referral
   * code, and never changed after activation: `referralLockedAt` records when
   * it became permanent. Level 2 is this agent's referrer's referrer, walked at
   * read time; the programme stops there.
   */
  referredById    String?
  referredBy      DataAgent?  @relation("AgentReferral", fields: [referredById], references: [id], onDelete: SetNull)
  recruits        DataAgent[] @relation("AgentReferral")
  /**
   * When the referral relationship became permanent. Once set, nothing — not
   * even an admin — may point this agent at a different referrer.
   */
  referralLockedAt DateTime?

  // --- Leaderboard points ---------------------------------------------------
  /**
   * Points in hand, moved only by writing a DataAgentPoint row — the same rule
   * the cedi balance follows, so the two can always be reconciled against each
   * other. Points are not money: they are earned from leaderboard places and
   * recent performance, and spent on rewards the admin has configured.
   */
  pointsBalance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices      DataAgentPrice[]
  ledger      DataAgentLedger[]
  withdrawals DataAgentWithdrawal[]
  orders      DataOrder[]
  afa         AfaRegistration[]
  points      DataAgentPoint[]
  redemptions DataRewardRedemption[]
  topups      DataWalletTopup[]
  // Ledger rows this agent's own activity *paid someone else* — their upline's
  // referral and team-sales commissions.
  earnedFor   DataAgentLedger[]     @relation("LedgerSourceAgent")
  teamOrders  DataOrder[]           @relation("TeamUpline")
  teamAfa     AfaRegistration[]     @relation("AfaTeamUpline")

  @@index([status])
  @@index([referredById])
  @@index([setupFeePaidAt])
}

// An agent's own retail price for one bundle. Absent = the agent sells that
// bundle at NikiMart's agent price (zero commission) — present and inactive =
// the bundle is hidden from their storefront entirely.
model DataAgentPrice {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  network  String
  sizeGb   Float
  // What the agent charges their customer (GH₵). Must be ≥ the agent price.
  price    Float
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, network, sizeGb])
  @@index([agentId, isActive])
}

// Every movement on an agent's balance, newest first on the wallet screen.
// Balances are only ever changed by writing one of these rows, so the ledger
// and the balance can always be reconciled against each other.
model DataAgentLedger {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // SETUP_FEE | SETUP_FEE_PAYMENT | COMMISSION | REFERRAL_L1 | REFERRAL_L2 |
  // REFERRAL_FEE_SHARE | TEAM_COMMISSION | ORDER_REFUND | WALLET_TOPUP |
  // WALLET_ORDER | REWARD_PAYOUT | WITHDRAWAL | WITHDRAWAL_REVERSAL | ADJUSTMENT
  type         String
  // Signed GH₵: negative debits the agent, positive credits them.
  amount       Float
  // Balance after this entry was applied, so history never has to be replayed.
  balanceAfter Float
  narration    String  @default("")
  // The order / withdrawal / admin action this entry came from.
  reference    String?

  // --- Referral and team earnings ------------------------------------------
  /**
   * The agent whose activity produced this entry: the recruit whose
   * registration fee was paid, or the downline agent who made the sale. Null on
   * everything an agent earned themselves. It is what makes a referral credit
   * traceable back to its source rather than just a line of narration.
   */
  sourceAgentId String?
  sourceAgent   DataAgent? @relation("LedgerSourceAgent", fields: [sourceAgentId], references: [id], onDelete: SetNull)
  /**
   * Which referral level paid this: 1 for a direct recruit, 2 for a recruit's
   * recruit. Null when the entry has nothing to do with the referral programme.
   */
  referralLevel Int?
  /**
   * The one thing that makes a commission payable exactly once.
   *
   * Every automatic credit derives a key from what it is paying for —
   * "REFERRAL_L1:<recruit id>", "TEAM_COMMISSION:<order id>" — and the unique
   * index refuses the second write. Guarded status flips already stop the
   * ordinary races; this stops the extraordinary ones too (a retry that lands
   * after a status was reset by hand, two sweeps on two instances), because the
   * database, not the code path, is what says no.
   */
  dedupeKey String? @unique

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([reference])
  @@index([agentId, type, createdAt])
  @@index([sourceAgentId])
}

/**
 * An agent putting money into their own wallet through Paystack.
 *
 * The row exists before the agent ever reaches the gateway, and that is its
 * whole point. A top-up used to be nothing but a reference handed to Paystack
 * with the agent id in the transaction metadata: if the money was captured but
 * the settlement never ran — a callback that landed on a deployment without the
 * code, a webhook dropped, metadata missing on a replay — there was no record
 * anywhere that the agent had ever tried, and the payment could only be found
 * by going through the Paystack dashboard by hand.
 *
 * With this, an unsettled top-up is a row somebody can see: the wallet shows
 * it, the sweep re-checks it against Paystack, and crediting it needs nothing
 * but the reference. `creditedAmount` is what Paystack actually captured, which
 * is what was credited — never `amount`, which is only what was asked for.
 */
model DataWalletTopup {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /** The Paystack reference (NT-…). Unique, so a top-up settles once. */
  reference String @unique
  /** What the agent asked to pay (GH₵). */
  amount    Float
  /** What was actually captured and credited. 0 until it settles. */
  creditedAmount Float @default(0)

  // pending | paid | abandoned
  status String    @default("pending")
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([status, createdAt])
}

// A commission withdrawal to MoMo. Admins process these by hand from the
// data console, exactly as Justice does.
model DataAgentWithdrawal {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // What the agent receives on MoMo.
  amount Float
  // Flat platform fee added on top and debited with the payout.
  fee    Float @default(0)

  momoPhone   String
  momoName    String
  momoNetwork String

  // pending | processed | rejected
  status      String    @default("pending")
  adminNote   String    @default("")
  processedBy String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Leaderboard, points and rewards
//
// Sell, rank, earn points, redeem. Nothing here holds a standing: the boards
// are counted from the orders and referrals that already exist, so they cannot
// drift from the business they are describing. What *is* stored is the part
// counting can't reproduce — points awarded for a place in a period that has
// since closed, and what an agent spent them on.
// ---------------------------------------------------------------------------

/**
 * One movement of an agent's points, and the only way `pointsBalance` moves.
 *
 * `dedupeKey` is what makes a placement pay exactly once: the award for first
 * place on the sales board for September is "RANK:SALES:2026-09:<agentId>",
 * and the unique index refuses the second write however many times the sweep
 * runs.
 */
model DataAgentPoint {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // RANK_SALES | RANK_RECRUITS | RANK_PERFORMANCE | PERFORMANCE_BONUS |
  // REDEMPTION | REFUND | ADJUSTMENT
  type String
  // Signed: positive earns, negative spends.
  points Int
  // Points in hand after this entry, so history never has to be replayed.
  balanceAfter Int
  narration    String @default("")
  /** The ranking period this was awarded for, e.g. "2026-09" or "2026-W37". */
  periodKey String?
  /** The place that earned it: 1, 2 or 3. Null on everything else. */
  rank      Int?

  dedupeKey String? @unique

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([periodKey])
}

/**
 * A reward agents can spend points on. Entirely the admin's: what it is called,
 * what it costs in points, whether it pays cedis or a data bundle, and whether
 * it is on the shelf at all. Nothing in the code assumes a price or a tier.
 */
model DataRewardTier {
  id    String @id @default(cuid())
  label String
  // CASH | BUNDLE
  kind  String @default("CASH")
  /** What it costs the agent. */
  points Int
  /** Credited to the agent's balance when the reward is a cash one. */
  cashAmount Float @default(0)
  /** The bundle sent when the reward is a data one. */
  network String @default("")
  sizeGb  Float  @default(0)

  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  redemptions DataRewardRedemption[]

  @@index([isActive, order])
}

/**
 * An agent spending their points. The points leave the moment it is asked for
 * — so they can't be spent twice while an admin works through the queue — and
 * come back if it is rejected, exactly as a withdrawal does with cedis.
 */
model DataRewardRedemption {
  id      String    @id @default(cuid())
  agentId String
  agent   DataAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tierId String?
  tier   DataRewardTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  // Snapshotted from the tier, so editing or retiring it never rewrites what
  // somebody redeemed.
  label      String
  kind       String @default("CASH")
  points     Int
  cashAmount Float  @default(0)
  network    String @default("")
  sizeGb     Float  @default(0)
  /** Where a bundle reward should be sent. Empty on a cash one. */
  recipientPhone String @default("")

  // pending | fulfilled | rejected
  status      String    @default("pending")
  adminNote   String    @default("")
  processedBy String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([status, createdAt])
}

// Broadcast announcements shown to agents (Justice's Notifications screen).
model DataAnnouncement {
  id       String  @id @default(cuid())
  title    String
  body     String
  // info | warning | success — drives the accent on the notice card.
  tone     String  @default("info")
  isActive Boolean @default(true)
  // Pinned notices sort above the rest regardless of date.
  isPinned Boolean @default(false)
  /**
   * Who it is for: AGENTS, CUSTOMERS or EVERYONE. A notice about commission is
   * not a notice a customer buying a bundle should read.
   */
  audience String  @default("AGENTS")
  /**
   * When it starts mattering, and when it stops. Null publishAt means "now";
   * null expiresAt means "until somebody hides it". Between them they cover
   * the thing this is actually used for — writing on Sunday about a change
   * that starts on Monday and is irrelevant by Friday.
   */
  publishAt DateTime?
  expiresAt DateTime?
  /** Who wrote it. A broadcast nobody can be asked about is one nobody owns. */
  createdBy String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
  @@index([audience, isActive])
}

// A callback request raised from the agent Support screen.
model DataSupportRequest {
  id       String  @id @default(cuid())
  agentId  String?
  fullName String
  phone    String
  language String  @default("English")
  message  String

  // open | resolved
  status     String    @default("open")
  adminNote  String    @default("")
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/**
 * An application to become an agent.
 * Signup is an application, not an instant account: someone gives their name,
 * contact, email and the store name they want, and an admin approves it. That
 * ordering matters — the store slug is a public URL and the agent's identity to
 * their customers, so it gets a human look before it exists, and NikiMart
 * chooses who resells under its name.
 * Approving provisions the User and the DataAgent and issues a one-time setup
 * link, so no password is collected here — nothing worth stealing sits in this
 * table while it waits.
 */
model DataAgentApplication {
  id String @id @default(cuid())

  fullName    String
  phone       String
  email       String
  /**
   * The store name they typed, exactly as they typed it.
   */
  storeName   String @default("")
  /**
   * The store link they asked for, already normalised.
   */
  desiredSlug String
  /**
   * Optional note from the applicant.
   */
  note        String @default("")
  /**
   * The agent code the applicant typed, if they were recruited by an existing
   * agent — stored exactly as given so an admin can see what was claimed even
   * when it turns out to be a typo. The relationship itself is only created on
   * approval, once the code has been resolved to a live agent.
   */
  referralCode String @default("")
  /**
   * The admin-issued registration link this applicant came through, if any.
   * Kept beside the referral code and read the same way: what was claimed,
   * with the discount it granted snapshotted into the fee columns below, so an
   * invite edited or deleted later never rewrites what somebody was charged.
   */
  inviteCode   String @default("")
  /**
   * The agent the code resolved to when the application was submitted. Held
   * here so the queue can show who is recruiting whom before anything is
   * approved; approval re-resolves it rather than trusting this.
   */
  referrerId   String?
  /**
   * How the applicant chose to settle the registration fee: BALANCE (deducted
   * from the agent account as a negative, cleared out of commission) or UPFRONT
   * (paid through Paystack before the store opens). Referral rewards are
   * released either way, but only once the fee has actually been paid.
   */
  feeMethod    String @default("BALANCE")

  // pending | approved | rejected
  status     String    @default("pending")
  reviewedBy String?
  reviewedAt DateTime?
  /**
   * Why it was rejected, shown to the applicant if they ask.
   */
  adminNote  String    @default("")

  /**
   * SHA-256 of the one-time setup token, never the token itself. Set on
   * approval and cleared once the agent has chosen a password.
   */
  setupTokenHash String?
  setupExpiresAt DateTime?
  /**
   * The account created on approval, once it exists.
   */
  agentId        String?

  // --- What the applicant set for themselves --------------------------------
  /**
   * The password they chose on the signup form, hashed. It is moved onto the
   * Nickimart user account at approval and cleared here at the same moment, so
   * a hash never outlives the application it was collected on.
   *
   * Collecting it up front is what lets an approved agent simply sign in: there
   * is no setup link to deliver, and therefore no registration that can end
   * with an account nobody can get into because a text never arrived.
   */
  passwordHash String?
  /**
   * True when that hash is of a password *we* generated and sent, rather than
   * one the applicant typed. It rides through approval onto the account, which
   * is then made to change it at first sign-in.
   */
  passwordIsTemporary Boolean @default(false)
  /**
   * When the username and that password were sent. Null means they have not
   * been, and the guarded write that sets it is what keeps a webhook and a
   * redirect settling the same payment from sending two different passwords.
   */
  credentialsSentAt DateTime?
  firstName    String  @default("")
  lastName     String  @default("")

  // --- The registration fee, paid before anybody reviews this ---------------
  /**
   * What this applicant was quoted, after any referral waiver. Held on the
   * application because it is what they actually paid, and the programme fee
   * may change between paying and being approved.
   */
  feeAmount     Float   @default(0)
  /**
   * The rest of that quote, exactly as the signup form showed it: the fee at
   * full price, the waiver their recruiter's code granted, what it was worth,
   * and the share of what they pay that recruiter is owed. Kept because it is
   * what they were charged — the programme's fee can move between paying and
   * being approved, and a registration must always read back as the deal that
   * was actually struck.
   */
  feeGross           Float @default(0)
  feeWaiverPercent   Float @default(0)
  feeWaived          Float @default(0)
  feeReferrerShare   Float @default(0)
  /**
   * none    — there is nothing to pay (no fee, or it clears from commission).
   * pending — a Paystack transaction was started and hasn't been confirmed.
   * paid    — the money is in. Only then may the application be approved.
   */
  paymentStatus String  @default("none")
  /** The Paystack reference of the payment, for verification and reconciliation. */
  feeReference  String?
  feePaidAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /**
   * When the applicant accepted the agent policy.
   */
  termsAcceptedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
  @@index([desiredSlug])
  @@index([referrerId])
  @@index([feeReference])
}

/**
 * A registration link issued by Nickimart itself.
 *
 * An agent's invite link carries their agent code and pays them a share of what
 * their recruit is charged. This is the other kind: a link the admin hands out
 * directly — at an event, to a partner, to somebody they simply want on board —
 * where the discount is whatever they decided when they made the link and
 * nobody earns a referral share, because nobody recruited them.
 *
 * `waiverPercent` is the whole configuration: 0 is full price, 100 waives the
 * registration fee entirely. Usage is capped and dated so a link that leaks
 * cannot go on discounting registrations forever.
 */
model DataAgentInvite {
  id String @id @default(cuid())
  /** The token in the URL: /become-an-agent?invite=<code>. */
  code String @unique
  /** What this link is for, in the admin's own words. */
  label String @default("")

  /** How much of the registration fee it takes off, 0–100. 100 waives it. */
  waiverPercent Float @default(0)

  /** How many registrations it may open. 0 is unlimited. */
  maxUses   Int @default(0)
  usedCount Int @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  /** The `User.id` of the admin who issued it, for the audit trail. */
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

// ---------------------------------------------------------------------------
// Settings for the data-bundle console.
//
// The retail side has its own SiteSetting table in the retail database. This is
// the same idea for this one, and it lives here so the bundle business carries
// its own configuration: restore this database and the price ladder, the agent
// programme and the referral rates all come back together, in step with the
// orders they priced.
// ---------------------------------------------------------------------------
model DataSetting {
  key   String @id
  value String
}
